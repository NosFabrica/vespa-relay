__pycache__/
*.pyc
.venv/
venv/
.env
# ...and every variant. A backup called `.env.bak-...` is not matched by `.env`,
# and one was committed with a live RELAY_NSEC in it exactly that way.
.env.*
!.env.example
*.tgz
.DS_Store

# Gradle / build outputs (all modules)
.gradle/
build/
**/build/
!gradle/wrapper/
.kotlin/
# Machine-local Gradle config (SDK paths etc.) — never commit
local.properties

# IDE
.idea/
*.iml

# The live router config — machine-local (relay list, filters, stream urls).
# router.conf.example is the tracked template.
router.conf

# Parse audit reports and router sync cursors (PARSE_AUDIT_FILE /
# ROUTER_SYNC_STATE_FILE, both under the compose ./.audit mount)
.audit/

# Local event store (SQLite + WAL/SHM) and sync cursors
*.db
*.db-shm
*.db-wal
*.db.state.json
sync-state.json
# Local compose overrides — compose auto-loads this file, so a committed one
# would rewrite every deployment's networking. Machine-specific by design.
docker-compose.override.yml

# Example router config — mirror events from other relays into this one.
#
# The router runs as its own process (the compose `sync` service; the profile
# is the on-switch). Copy this file and start it:
#   cp router.conf.example router.conf
#   SYNC_CONFIG_LOCAL=./router.conf docker compose --profile sync up -d --build
#
# Edited it? Restart only the mirror — the relay keeps serving:
#   docker compose --profile sync restart sync
#
# Running without Docker, set SYNC_CONFIG_FILE to the path of your copy on the
# SYNC process (`./gradlew :sync:run` / the vespa-sync binary) — the relay
# refuses to boot with it set, because it no longer runs the mirror.
#
# This file as it stands is what we run. You can use it unchanged.
#
#
# TWO PLANES, ONE FILE
#
# The config describes two things that never share a clock:
#
#   monitor   parses relay urls out of the store (10002 outbox lists, 10009
#             group lists, anything with a url in a tag), probes every one —
#             reachability, aliasing, consistency, whether `until` is honoured,
#             whether NIP-77 is spoken, whether our auth sticks — and signs the
#             verdict onto that relay's kind-30166 record. The verdict a stream
#             cares about is one tag: ["l", "prime"]. Everything is measured
#             on the socket; NIP-11 is never trusted for a decision.
#
#   streams   mirror events. A stream whose relaySource consults those
#             kind-30166 records builds its relay list from the verdicts — one
#             indexed query, no relay-list parsing, no per-worker guards — and
#             rides the rotating pool:
#             socket-owning workers, catch-up pages, then a LIVE TAIL on the
#             open socket so new events arrive the moment they exist.
#
# A new url is probed by the monitor's fast lane within minutes
# (monitor.fastLaneSeconds) and joins the fan-out on its first `prime`.
#
#
# HOW A STREAM WORKS
#
# Each entry under `streams` mirrors one NIP-01 `filter`:
#
#   dir             "down" pulls into this relay, "up" pushes ours out
#   filter          the NIP-01 filter to mirror — kinds, since/until
#   urls            static relays to talk to (bypass the monitor's verdicts)
#   relaySource     where the relay list comes from: scans of relay-list events
#                   (10002, 10009, ...), or monitor kind-30166 verdicts —
#                   `filter = { "kinds": [30166], "#l": ["prime"] }`
#   sync            how to ask (see below)
#   auditSeconds   fetch forward, audit the past: when a relay's last verified
#                   full pass is older than this, its next visit reconciles the
#                   covered history over NIP-77 in windows and downloads only
#                   the diff. A week keeps history honest for the cost of a
#                   trickle — each relay's clock is its own, so audits stagger
#                   themselves at roster/auditSeconds per second.
#
# NOTE `sync` chooses the TRANSPORT of a static stream (negentropy vs paged
# fetch), not whether it syncs — kept as `sync` for strfry familiarity.
# CHOOSING `sync` — static `urls` streams only. A relaySource stream has one
# shape and no choice to make: page forward from the band's edge, live-tail
# the present, reconcile the covered past on the auditSeconds audit.
#
#   negentropy  the relays hold much the same events we do. Compares the two
#               sets and transfers only the difference.
#   fetch       the relays hold events nobody else has, or the overlap is
#               unknown. Pages forward from the band's edge.
#   auto        reconcile once we already hold a lot of the filter, else fetch.

connectionTimeout = 20

# THE POOL'S SOCKETS. Two numbers govern every socket the visit-mode streams
# own. visitConcurrency is the dial width: how many relays are visited — and
# therefore TLS-handshaking — at once; a visit is seconds long, so this bounds
# the burst, not the throughput. tailBudget is the steady state: how many live
# tails stay open, which is what "constantly connected" means; past it, tails
# are earned by recent yield. Their sum plus monitor.dialConcurrency and the
# static upstreams must stay under the dispatcher's 1,024.
visitConcurrency = 128
tailBudget = 600

# THE MONITOR PLANE. Owns every question about a relay's health and shape, on
# its own clock, so no stream ever waits on a probe.
monitor {
    # Where candidate urls come from — the same select syntax streams use.
    # NIP-65 write relays, and NIP-29 group hosts (their tag carries the url at
    # element 2, the one relay list in the protocol that does not put it at 1).
    sources = [
        {
            select = [ { kind = 10002, tag = "r", marker = "write" } ]
            filter = { "kinds": [10002] }
        },
        {
            select = [ { kind = 10009, tag = "group", relay = 2 } ]
            filter = { "kinds": [10009] }
        },
        {
            # NIP-85 provider relays (10040 service tags carry the url at 2).
            # As writable as a 10002 — same dead hosts, same spammed urls — so
            # they earn verdicts here and the assertions stream dials only the
            # ones a verdict vouches for.
            select = [
                { tag = "30382:rank",      relay = 2 }
                { tag = "30382:followers", relay = 2 }
            ]
            filter = { "kinds": [10040] }
        }
    ]

    # Urls or regexes never probed, never verdicted. A plain url matches by
    # normalized equality; an entry with a regex metacharacter (* + ? [ ] etc —
    # a dot does not count) must match a discovered url in full, ignoring case.
    exclude = [
        "wss://filter.nostr.wine/npub.*"
    ]

    # The full sweep: every candidate re-verdicted this often.
    sweepSeconds = 21600

    # The fast lane: how often to look for urls named by relay-list events
    # ingested since the last look, and run the fitness probe over just those.
    # This is what bounds a NEW relay's wait for its first `prime` at
    # minutes. 0 turns the lane off.
    fastLaneSeconds = 120

    # Relays a probe pass dials at once — the sweep's wall clock, since most
    # of a discovered corpus is dead and a dead relay costs a full timeout.
    # Also the most sockets the monitor ever holds (its passes run one at a
    # time), so size it against the socket budget the sync plane leaves free.
    dialConcurrency = 128
}

streams {

    # Loads a seed of users from popular relays. Static urls bypass the
    # verdicts — a pinned upstream is an operator's decision, and the monitor
    # records it like any other relay without gating it.
    indexers {
        dir = "down"
        # Bootstrap. On an empty store there is nothing to reconcile against,
        # and these are what create the overlap every later stream depends on —
        # including the 10002s the monitor's own sources read.
        sync = "fetch"
        filter = { "kinds": [0, 10002] }
        urls = [
            "wss://purplepag.es",
            "wss://profiles.nostr1.com",
            "wss://indexer.coracle.social",
            "wss://user.kindpag.es",
            "wss://directory.yabu.me"
        ]
    }

    # Every profile, relay list and provider list, from every relay the monitor
    # certifies. Kinds-only asks — author narrowing is gone: with 32M pubkeys
    # in the store no chunking cadence rotates the key space fast enough for
    # narrowing to mean anything, and a kinds-only filter is a few hundred
    # bytes against every relay's message cap.
    profileViaOutbox {
        dir  = "down"
        filter = { "kinds": [0, 10002, 10040] }
        # The monitor's verdicts ARE the relay list: kind-30166 records,
        # admitting every relay whose indexed `l` tag says prime and whose
        # record is newer than maxAgeSeconds. A monitor republishes the record
        # when it re-checks, so the event's own clock dates the check — the
        # reading every other NIP-66 consumer applies.
        #
        # WHOSE verdicts is `authors`, and it means what it means in any other
        # NIP-01 filter: left off, EVERY monitor whose 30166s reached this
        # store. On a stock deployment that is one identity, our own, because
        # nothing here mirrors anyone else's 30166s — but add 30166 to a
        # stream's kinds, or point one at a public monitor, and those verdicts
        # join this roster too.
        #
        # A `filter { }` block IS a NIP-01 filter, so `authors` is 64-char hex,
        # exactly as it goes on the wire — copy one out of a REQ and it works.
        # Bech32 stays in the settings that are ours to define (RELAY_NSEC and
        # the relay's pubkey lists); it does not go inside the protocol's own
        # object, and an npub here is refused rather than quietly decoded.
        relaySource = [
            {
                filter = { "kinds": [30166], "#l": ["prime"] }
                # ...naming the monitors to trust, and nobody else:
                # filter = { "kinds": [30166], "#l": ["prime"], "authors": ["3bf0c63f…"] }
                # How stale a verdict may be and still admit its relay, measured
                # on the record's own clock. There is NO default: nothing in the
                # router knows which filters describe a measurement that goes
                # stale and which describe a list that does not, so an unwritten
                # bound is no bound. Two 6h sweeps + slack — one missed sweep
                # must not empty the roster, three missed sweeps is a monitor
                # whose silence should.
                maxAgeSeconds = 50400
                # How often to RE-READ this source. One indexed query, so it can
                # run far more often than a relay-list scan — and it has to: this
                # is what bounds a newly-certified relay's wait to join the
                # fan-out. Left off it would inherit the stream's refreshSeconds,
                # six hours by default, against a fast lane that verdicts a new
                # url in two minutes.
                refreshSeconds = 120
            }
        ]
        # ROTATING RELAY_NSEC: name the OLD key's hex here first. The new one starts
        # writing verdicts the moment it boots, but the store's existing ones
        # are the old key's, and a source scoped to the new identity alone
        # selects nothing until a full sweep has run — an empty roster for up
        # to `monitor.sweepSeconds`. Scoped to both, or left unscoped, the
        # roster never dips and the old key comes out once the new one covers
        # the corpus.
        auditSeconds = 604800  # weekly negentropy audit of the covered past
    }

    assertions {
        dir = "down"
        # ENFORCED: the provider's relay is the source of truth, and a score
        # it stopped serving is deleted here after — and only after — a clean
        # full reconcile. Start a new deployment at "dryRun" and read the
        # would-delete lines for a few days before flipping this.
        deleteMissing = true
        # The provider's relay is the source of truth for its OWN scores, and
        # for nothing else here. Kind 0/10002 ride along so we pick them up if
        # it serves them (NIP-85 says it should; measured, none do) — they are
        # deleted only when a service's whole score set is retracted, never for
        # being absent from a relay that was never going to have them.
        ownedKinds = [30382]
        filter = { "kinds": [0, 10002, 30382] }
        refreshSeconds = 21600
        # Still a scanned source, and still author-bound: a provider stream's
        # whole meaning is "THIS service's records from THIS relay", which is
        # the one place narrowing earns its keep. The pool makes one ask per
        # bound author, so each (relay, service) band stays valid forever.
        relaySource = [
            {
                select = [
                    { tag = "30382:rank",      relay = 2, authors = 1 }
                    { tag = "30382:followers", relay = 2, authors = 1 }
                ]
                filter = { "kinds": [10040] }
            }
        ]
        # WHICH URLS THIS STREAM MAY DIAL AT ALL. Beside `exclude` and for the
        # same reason: `exclude` says which urls are forbidden however many
        # sources name them, `gatedBy` says which are permitted however many
        # sources found them. Neither is a property of how a url was found,
        # which is all a relaySource entry describes. Every source's discovery
        # is intersected with the union of these.
        #
        # The scan above supplies the (relay, provider) pairing; this supplies
        # the right to be dialled. 300 users write 10040s today; millions will,
        # with the same spammed dead urls a 10002 carries, and without a gate
        # each of them costs a dial and a timeout per cycle forever. An ungated
        # url waits like any new relay: the fast lane probes it within minutes.
        #
        # Any NIP-01 filter can be the gate. This one is monitor verdicts; add
        # `"authors": ["3bf0c63f…"]` to name whose, or point it at a curated list
        # entirely — with a `select` saying where that list keeps its urls,
        # since only kind 30166 has the position fixed by the protocol (the `d`
        # tag). Nothing in the router knows that `s` is the tag or that
        # `prime` is the value — a monitor spelling its opinion
        # `["status", "live"]` needs no code change here, only this filter
        # written differently. A stream with no `gatedBy` dials whatever its
        # sources name and says so at boot.
        gatedBy = [
            { filter = { "kinds": [30166], "#l": ["prime"] }, maxAgeSeconds = 50400, refreshSeconds = 120 }
        ]
        # The deleteMissing comparison runs as this stream's history audit —
        # daily: each (relay, provider) band ages on its own clock, and a
        # deletion decision deserves the audited full-history reconcile.
        auditSeconds = 86400
    }

    # The content mirror: every public kind worth searching, from every relay
    # the monitor certifies. 5 (NIP-09 deletion request) and 62 (NIP-62 request
    # to vanish) travel with the content they retract — the store enforces both
    # at insert, and the stored tombstone is what keeps later downloads from
    # resurrecting a deleted note. 10009 rides along both as the group picker's
    # source and as the monitor's group-host source.
    contentViaOutbox {
        dir  = "down"
        filter = { "kinds": [
            0, 1, 5, 9, 11, 14, 20, 21, 22, 24, 40, 41, 42, 54, 62, 1010, 1063,
            1065, 1068, 1111, 1163, 1301, 1311, 1312, 1313, 1315, 1337, 1617,
            1618, 1621, 1622, 1630, 1808, 1985, 2003, 2004, 2473, 3302, 5050,
            5100, 5129, 5250, 5302, 5303, 6969, 8333, 9002, 9041, 9321, 9734,
            9735, 9736, 9737, 9802, 10002, 10003, 10009, 10040, 10100, 10154,
            11871, 12473, 15128, 15129, 30000, 30001, 30002, 30003, 30004, 30005,
            30006, 30009, 30015, 30017, 30018, 30019, 30020, 30023, 30030,
            30054, 30055, 30063, 30175, 30176, 30177, 30267, 30296, 30297,
            30298, 30311, 30312, 30313, 30315, 30382, 30402, 30617, 30620,
            30817, 30818, 31337, 31871, 31872, 31873, 31890, 31922, 31923,
            31924, 31925, 31990, 32267, 33401, 33863, 34139, 34235, 34236,
            34550, 35128, 35129, 36787, 38000, 38192, 38383, 39000, 39089,
            39092, 39701, 40002, 40100, 45001, 45003, 48106
        ] }
        relaySource = [
            {
                filter = { "kinds": [30166], "#l": ["prime"] }
                maxAgeSeconds = 50400
                refreshSeconds = 120  # see profileViaOutbox
            }
        ]
        auditSeconds = 604800
    }
}

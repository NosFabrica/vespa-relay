# Example router config — mirror events from other relays into this one.
#
# Copy it and switch it on:
#   cp router.conf.example router.conf
#   SYNC_CONFIG_LOCAL=./router.conf \
#   SYNC_CONFIG_FILE=/etc/vespa-relay/router.conf \
#   docker compose up --build
#
# Running without Docker, set SYNC_CONFIG_FILE to the path of your copy.
#
# This file as it stands is what we run. You can use it unchanged.
#
#
# HOW A STREAM WORKS
#
# Each entry under `streams` mirrors one NIP-01 `filter` from a set of relays:
#
#   dir      "down" pulls into this relay, "up" pushes ours out, "both" does each
#   filter   the NIP-01 filter to mirror — kinds, authors, tags, since/until
#   urls     the relays to talk to
#   sync     how to ask for what we are missing (see below)
#
# Instead of a fixed `urls` list, a stream can find its relays in the events this
# relay already holds — a `relaySource`. That is how the last two streams reach
# tens of thousands of relays without naming any of them.
#
#
# CHOOSING `sync`
#
#   negentropy  the relays hold much the same events we do. Compares the two sets
#               and transfers only the difference. Right for common kinds.
#   fetch       the relays hold events nobody else has. Comparing two sets that
#               barely overlap costs more than just downloading. Right for a
#               first fill, and for per-publisher data like NIP-85 scores.
#   auto        decide by size (the default). Prefer saying which you mean.

connectionTimeout = 20

streams {

    # Seed the store from relays that specialise in profiles and relay lists.
    #
    # Everything below depends on this: a `relaySource` reads relay urls out of
    # events we already hold, so on an empty store there is nothing to read.
    indexers {
        dir = "down"
        # `fetch`, because an empty store has nothing to compare against.
        sync = "fetch"
        # The seed relays carry long-form too — asked by kind, nos.lol alone
        # returned 96,298 kind-30023 events.
        filter = { "kinds": [0, 10002, 10040, 30023] }
        urls = [
            "wss://purplepag.es",
            "wss://profiles.nostr1.com",
            "wss://indexer.coracle.social",
            "wss://user.kindpag.es",
            "wss://directory.yabu.me",

            "wss://relay.primal.net",
            "wss://relay.damus.io",
            "wss://nos.lol",
            "wss://nostr.mom",
            "wss://nostr-pub.wellorder.net",
            "wss://relay.ditto.pub",
            "wss://wot.grapevine.network"
        ]
    }

    # Follow everyone's NIP-65 relay lists out to the rest of the network.
    #
    # `relaySource` scans the kind-10002 events we hold and takes the write
    # relays out of them, so this stream's relay list grows as the store does —
    # tens of thousands of relays, none of them named here.
    dataViaOutbox {
        dir = "down"
        # These kinds are on every relay, so the overlap with what we already
        # hold is large. Reconciling moves the difference; fetching would move
        # all of it again.
        sync = "negentropy"
        # Every kind quartz can extract search text from, asked of every relay.
        #
        # The list is not hand-written: it is what SearchFieldExtractor actually
        # dispatches on at the pinned quartz — 63 kinds — plus 10002 and 10040,
        # which the router needs for discovery rather than for search. If quartz
        # learns a kind, this is the file to widen.
        #
        # NOT narrowed by author. The outbox model can only find (author, relay)
        # pairs somebody published, and 71.3% of long-form authors publish no
        # relay list at all. Asked per-author it reached 302 relays for 496
        # events; asked by kind it reached 102 for 189,189. For a search index a
        # missing document is a result nobody ever sees.
        #
        # KIND 1 IS DELIBERATELY ABSENT. It is indexable and it is wanted
        # eventually, but it is billions of events where everything here
        # together is tens of millions — adding it changes this from a sync that
        # finishes into one that does not. Add `1,` below when that is the
        # intent, not by accident.
        #
        # Widening this filter invalidates the stream's cursor bands, so the
        # next cycle re-walks. That is by design.
        filter = { "kinds": [
            0, 11, 20, 40, 41, 54, 1063, 1301, 1313, 1337, 1618, 1621, 2003,
            5129, 9041, 9802, 10002, 10003, 10040, 10100, 10154, 15128,
            15129, 30000, 30001, 30002, 30003, 30004, 30005, 30006, 30009,
            30015, 30023, 30030, 30063, 30175, 30176, 30177, 30267, 30311,
            30312, 30313, 30402, 30617, 30620, 30817, 30818, 31337, 31890,
            31922, 31923, 31924, 31990, 32267, 33401, 33863, 34139, 34550,
            35128, 35129, 36787, 39000, 39089, 39092, 39701
        ] }
        refreshSeconds = 21600   # re-read the sources and re-sync every 6h
        concurrency = 100        # relays synced at the same time
        # The seed relays above already cover these; skip them here.
        exclude = [
            "wss://purplepag.es",
            "wss://profiles.nostr1.com",
            "wss://indexer.coracle.social",
            "wss://user.kindpag.es",
            "wss://directory.yabu.me",

            "wss://relay.primal.net",
            "wss://relay.damus.io",
            "wss://nos.lol",
            "wss://nostr.mom",
            "wss://nostr-pub.wellorder.net",
            "wss://relay.ditto.pub",
            "wss://wot.grapevine.network"
        ]
        relaySource = [
            {
                # Scan kind 10002, take the url from each `r` tag marked write.
                filter = { "kinds": [10002] }
                select = [
                    { kind = 10002, tag = "r", marker = "write" }
                ]
            }
        ]
    }

    # NIP-85 trust scores, from the providers people actually named.
    #
    # A kind-10040 says "I trust this provider, and you can find its scores on
    # this relay". This stream reads those lists and asks each relay only for
    # the providers it was named for.
    assertions {
        dir = "down"
        sync = "negentropy"
        filter = { "kinds": [30382] }
        refreshSeconds = 21600
        concurrency = 8
        exclude = []
        relaySource = [
            {
                filter = { "kinds": [10040] }
                # A provider list tags ["30382:rank", provider, relay] — the
                # provider and its relay are in the SAME tag, so read both from
                # it: `relay` is which relay to ask, `authors` is who to ask for.
                #
                # Without the `authors` binding, every relay here is asked for
                # every provider on the network, and answers mostly nothing.
                select = [
                    { tag = "30382:rank",      relay = 2, authors = 1 }
                    { tag = "30382:followers", relay = 2, authors = 1 }
                ]
            }
        ]
        # Ask about one provider at a time. Slower to start, but each provider
        # then keeps its own resume point, so adding a new provider list does not
        # make the others re-sync from scratch.
        authorsPerLeg = 1

        # DELETES DATA. Off unless you set it.
        #
        # When a provider's own relay no longer has a score we hold, drop it. A
        # provider is the source of truth for its own scores, and it usually
        # withdraws one because the person it rated turned out to be a scammer —
        # so keeping a withdrawn score is worse than losing it.
        #
        # Only safe here because:
        #   * this filter is kind 30382 alone. Widen it and a relay that simply
        #     does not carry kind 0 would delete that provider's profile.
        #   * it needs `sync = "negentropy"`. Only a reconcile compares whole
        #     sets; a fetch would read "we never asked" as "it is gone".
        #
        # A relay that cannot reconcile is downloaded from as usual and never
        # deleted against. Nothing is ever published to the upstream.
        #
        # Note: if someone's 10040 names a relay that never carried their
        # provider's scores, those scores are dropped and fetched again from
        # wherever they are. Set it to "dryRun" to see what it would delete.
        deleteMissing = true
    }







}

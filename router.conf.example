# Example router config — a strfry-style `streams` mirror.
#
# Copy to router.conf and enable it with:
#   ROUTER_CONFIG_LOCAL=./router.conf \
#   ROUTER_CONFIG_FILE=/etc/vespa-relay/router.conf \
#   docker compose up --build
#
# Without Docker, point the relay straight at it:
#
# Each named stream mirrors a NIP-01 `filter` from a set of `urls` in a `dir`
# (down = pull into our store, up = push ours upstream, both). Optional per
# verification for that upstream — leave off for public relays).
#
# A stream can also drop `urls` entirely and take its relay list from the store,
# with a `relaySource = [ ... ]` list — see the last two streams below.

connectionTimeout = 20

streams {

    # Loads a seed of users from popular relays
    indexersAndPopularRelays {
        dir = "down"
        filter = { "kinds": [0, 10002] }
        urls = [
            "wss://purplepag.es",
            "wss://profiles.nostr1.com",
            "wss://indexer.coracle.social",
            "wss://user.kindpag.es",
            "wss://directory.yabu.me",

            "wss://relay.primal.net",
            "wss://relay.damus.io",
            "wss://nos.lol",
            "wss://nostr.mom",
            "wss://nostr-pub.wellorder.net"
            "wss://relay.ditto.pub",
            "wss://wot.grapevine.network"
        ]
    }

    dataViaOutbox {
        dir = "down"
        # Every relay mirrors these kinds, so by the time this sweep runs the
        # indexers above have already given us most of what each of the 20,000
        # relays holds. Reconciling id sets moves almost nothing; fetching moves
        # all of it again.
        sync = "negentropy"
        filter = { "kinds": [0, 3, 10002, 10040] }
        refreshSeconds = 21600     # re-read the sources and re-sync every 6h
        concurrency = 100          # relays synced at the same time
        exclude = []               # relays to skip however many sources name them
        relaySource = [
            {
                select = [
                    { kind = 10002, tag = "r", marker = "write" }
                ]
                filter = { "kinds": [10002] }
            }
        ]
    }

    assertions {
        dir = "down"
        sync   = "negentropy"
        # The relay is asked per (relay, service) now, so its set and ours are the
        # SAME data — near-total overlap, which is what negentropy is for. The old
        # `fetch` reasoning ("millions each, no overlap") was about the un-narrowed
        # ask; binding the service to its relay inverted it.
        #
        # And a reconcile compares WHOLE sets, which a paged fetch never does — so
        # it can also see what we hold and the provider no longer serves. For its
        # own scores that provider is the source of truth, so absence is a
        # retraction and we drop it too.
        #
        # Nothing is published upstream to learn this. Absence has innocent causes
        # (retention, an AUTH gate, a half-served reconcile), so the router refuses
        # to act on a relay that served nothing for the ask, and refuses to delete
        # more than half of one in a cycle. Starting as a dry run: it reports what
        # it would drop and drops nothing.
        deleteMissing = "dryRun"
        # 30382 ONLY, and that is load-bearing rather than tidy. deleteMissing
        # applies to the whole ask, and the provider's relay is the source of
        # truth for its SCORES — not for its operator's profile or relay list.
        # Leaving kinds 0/10002 here would let a provider relay that simply does
        # not carry kind 0 retract that service's profile. Those two kinds are
        # mirrored by the other streams, which is where they belong.
        filter = { "kinds": [30382] }
        refreshSeconds = 21600     # re-read the sources and re-sync every 6h
        concurrency = 100          # relays synced at the same time
        exclude = []               # relays to skip however many sources name them
        relaySource = [
            {
                # A NIP-85 provider list tags ["30382:rank", service, relay], so
                # `relay` and `authors` are two slots of ONE tag and have to be
                # read together: this relay is then asked only for the services
                # it was advertised as carrying. Read into separate sets they
                # would give the cross product — every relay asked for every
                # service, which on a real store is ~96% empty asks.
                select = [
                    { tag = "30382:rank",      relay = 2, authors = 1 }
                    { tag = "30382:followers", relay = 2, authors = 1 }
                ]
                filter = { "kinds": [10040] }
            }
        ]
        # One service per ask, so a cursor band is (relay, one service) and a new
        # provider list ADDS a band rather than invalidating every other band on
        # that relay. Leave it out to put all of a relay's services in one ask.
        authorsPerLeg = 1
    }

    # `sync` picks how a stream asks for what it is missing, and it is about the
    # DATA, not the relay:
    #   negentropy  the same event lives on many relays (profiles, relay lists,
    #               follow lists) — reconcile id sets and transfer only the diff
    #   fetch       each relay holds its own events and nobody else's (NIP-85
    #               assertions) — reconciling compares huge sets for no match, so
    #               page from the sync cursor instead
    #   auto        (default) decide by size: reconcile only when both our store
    #               and the relay hold more than ROUTER_NEG_MIN_EVENTS for the
    #               filter. Correct only where overlap tracks volume — say which
    #               you mean when you know.
    #
    # ---- Dynamic relay lists ------------------------------------------------
    #
    # No `urls`: these two take their relays from events the streams above mirror
    # into our store. `relaySource` is a LIST of places to read urls from, all
    # merged into one fan-out. Every `refreshSeconds` the router re-reads them and
    # negentropy-syncs its `filter` against every relay they name — the whole set,
    # however far it has grown — `concurrency` at a time. Relays without NIP-77
    # fall back to a paged REQ fetch automatically, and unreachable ones are
    # tallied and skipped.
    #
    # `concurrency` is per stream, and the router's socket budget has to fit the
    # sum of them plus every `urls` upstream above: an open websocket occupies one
    # OkHttp dispatcher slot for its whole life, so the ceiling is real. An outbox
    # list on a mature store reaches five figures of relays, most of them long
    # dead, so this wants to be in the hundreds, not the single digits.
    #
    # Relay liveness is remembered too, as NIP-66 kind 30166 in this same store,
    # so a cycle stops re-dialling hosts that a previous one proved gone. Within a
    # cycle, failures are counted per HOST rather than per url — a filtering relay
    # is advertised as hundreds of per-user path urls, and a per-url counter never
    # adds up to a verdict on any of them. A host that ever delivers is never shed.
    #
    # Urls that could never work are dropped at discovery rather than dialled:
    # .onion (no Tor transport here) and loopback/private hosts (someone else's
    # `ws://localhost:4869` means THEIR machine). A relay that cannot be reached
    # in principle is worse than one that is merely down — it would burn a connect
    # timeout and a permit every cycle forever, and be recorded as unreachable
    # when the truth is we were never in a position to ask.
    #
    # The cheapest win here is a filter that includes kind 30166: those records are
    # ordinary events published by monitors like nostr.watch, so mirroring them
    # inherits the network's whole relay census before this relay dials anything.
    # Publishing our own findings back needs ROUTER_MONITOR_NSEC; reading does not.
    #
    # A finished sync is REMEMBERED per (relay, filter): a negentropy reconcile
    # compares the whole range, so the next cycle asks that relay only for what
    # arrived since — which is also what keeps the local id snapshot this fan-out
    # shares from being the entire corpus. Every ROUTER_FULL_RESYNC_SECONDS
    # (default 7 days) the whole filter is walked again, so a relay that gained
    # older events is not invisible forever. Nothing is capped; the full pass is
    # periodic rather than never.
    #
    # Each source entry is one scan: a `select` list saying which relay urls to
    # pull out, and the `filter` saying which events to pull them from. The filter
    # runs ONCE and every select is applied to what comes back, so a whole shelf
    # of relay-list kinds costs one query rather than one each.
    #
    # Each `select` entry is:
    #
    #   kind    apply this select only to that kind; omit to apply it to
    #           everything the filter collected. A kind the filter never returns
    #           simply never matches, so an unused select is harmless.
    #   tag     the tag name to read; omit for ANY tag, which is how you take a
    #           whole family (NIP-85's <kind>:<type> service tags) without naming
    #           each one. Omitting it also demands the value already start with
    #           ws:// or wss://, since with no tag name to go on anything in the
    #           event could otherwise land here.
    #   index   which element of the tag holds the url (default 1; use 2 for
    #           NIP-85 service tags and for e/p/a/q hints, which put an id or a
    #           pubkey first)
    #   where   conditions on the rest of the tag, shaped like NIP-01 filters:
    #           entries in the list OR together, the fields inside one entry
    #           AND. Omit to keep every tag. Each entry states any of:
    #
    #             index + equals   the element at that position (0 is the tag
    #                              name) is exactly that string — case-sensitive
    #                              and untrimmed, and a missing element matches
    #                              nothing, not even ""
    #             minSize          the tag has at least this many elements
    #             maxSize          the tag has at most this many elements
    #
    #           e.g. keep only root/reply e-tag hints:
    #             where = [ { index = 3, equals = "root" }
    #                       { index = 3, equals = "reply" } ]
    #   marker  sugar for NIP-65's rule: "write" / "read" expand to the where
    #           that keeps that side plus unmarked tags — with the url at 1,
    #             where = [ { index = 2, equals = "write" }
    #                       { index = 2, equals = "" }
    #                       { maxSize = 2 } ]
    #           (the slots follow the select's own index) — and "any" to no
    #           conditions at all. A select states `marker` or `where`, not both.
    #
    # `filter` is an ordinary NIP-01 filter — kinds, authors, since, until, limit,
    # "#t"-style tag filters. `since`/`until` are absolute unix seconds as always;
    # on a repeating cycle `limit` is the bound that stays meaningful, since a
    # fixed `since` only ages. A regular kind must narrow itself with `limit`,
    # `since` or `authors` — scanning one whole would load every matching event in
    # the store at once.
    #
    # Careful with the two tag notions: `tag = "e"` is the tag urls are READ FROM,
    # while `"#e" = [...]` in the filter narrows which events are scanned at all.
    #
    # These need events to fan out over, so keep at least one static `down` stream
    # above: that is what makes the first cycle non-empty.
    #
    # comfortably longer than `refreshSeconds` so consecutive cycles overlap
    # instead of leaving a gap between them. Drop it and every cycle reconciles
    # the filter's whole history — fine over negentropy, but a relay without
    # NIP-77 then re-pages its entire history on every single cycle.
}

# Example router config — mirror events from other relays into this one.
#
# The router runs as its own process (the compose `sync` service; the profile
# is the on-switch). Copy this file and start it:
#   cp router.conf.example router.conf
#   SYNC_CONFIG_LOCAL=./router.conf docker compose --profile sync up -d --build
#
# Edited it? Restart only the mirror — the relay keeps serving:
#   docker compose --profile sync restart sync
#
# Running without Docker, set SYNC_CONFIG_FILE to the path of your copy on the
# SYNC process (`./gradlew :sync:run` / the vespa-sync binary) — the relay
# refuses to boot with it set, because it no longer runs the mirror.
#
# This file as it stands is what we run. You can use it unchanged.
#
#
# HOW A STREAM WORKS
#
# Each entry under `streams` mirrors one NIP-01 `filter` from a set of relays:
#
#   dir      "down" pulls into this relay, "up" pushes ours out, "both" does each
#   filter   the NIP-01 filter to mirror — kinds, authors, tags, since/until
#   urls     the relays to talk to
#   sync     how to ask for what we are missing (see below)
#
# Instead of a fixed `urls` list, a stream can find its relays in the events this
# relay already holds — a `relaySource`. That is how the last two streams reach
# tens of thousands of relays without naming any of them.
#
#
# CHOOSING `sync`
#
#   negentropy  the relays hold much the same events we do. Compares the two sets
#               and transfers only the difference. Right for common kinds.
#   fetch       the relays hold events nobody else has. Comparing two sets that
#               barely overlap costs more than just downloading. Right for a
#               first fill, and for per-publisher data like NIP-85 scores.
#   auto        reconcile once we already hold a lot of the filter, else fetch
#               (the default). Prefer saying which you mean.

connectionTimeout = 20

streams {

    # Loads a seed of users from popular relays
    indexers {
        dir = "down"
        # Bootstrap. On an empty store there is nothing to reconcile against, and
        # these are what create the overlap every later stream depends on.
        sync = "fetch"
        filter = { "kinds": [0, 10002] }
        urls = [
            "wss://purplepag.es",
            "wss://profiles.nostr1.com",
            "wss://indexer.coracle.social",
            "wss://user.kindpag.es",
            "wss://directory.yabu.me"
        ]
    }

    profileViaOutbox {
        dir = "down"
        sync = "fetch"
        filter = { "kinds": [0, 10002, 10040] }
        refreshSeconds = 21600     # re-read the sources and re-sync every 6h
        concurrency = 100          # relays synced at the same time
        # Ignore any single event naming more relays than this — a real outbox
        # list is single digits, and the ones this exists for run to five
        # (measured: 148 pubkeys publishing kind 10002s of 100-10,591 entries,
        # every entry a dial). The event is dropped WHOLE, never truncated, so
        # its author cannot choose what we see by ordering it.
        #
        # SETTING THIS GIVES UP THE TAG PROJECTION for this source: a per-event
        # limit needs the event, and the projection returns values already
        # flattened across every event it matched. Unset, discovery keeps the
        # projection (a 2.6M-event scan became its walk). Duplicate urls are
        # folded either way — see AGENTS.md, "One relay behind many urls".
        maxRelaysPerList = 50
        # Each entry is a regex matched anywhere in a discovered url. A plain
        # url still excludes the one relay it names, and a host prefix like
        # "wss://filter.nostr.wine/" also drops every per-user url that host
        # mints (wss://filter.nostr.wine/npub1.../) — a shape no literal list
        # could keep up with. Anchor with ^/$ to mean exactly one url.
        exclude = [
            "wss://purplepag.es",
            "wss://profiles.nostr1.com",
            "wss://indexer.coracle.social",
            "wss://user.kindpag.es",
            "wss://directory.yabu.me",
            "wss://filter.nostr.wine/"
        ]
        relaySource = [
            {
                select = [
                   { kind = 10002, tag = "r", marker = "write" }
                ]
                filter = { "kinds": [10002] }
            }
        ]
    }

    assertions {
        dir = "down"
        sync   = "negentropy"
        deleteMissing = "dryRun"
        # The provider's relay is the source of truth for its OWN scores, and
        # for nothing else here. Kind 0/10002 ride along so we pick them up if
        # it serves them (NIP-85 says it should; measured, none do) — they are
        # deleted only when a service's whole score set is retracted, never for
        # being absent from a relay that was never going to have them.
        ownedKinds = [30382]
        filter = { "kinds": [0, 10002, 30382] }
        refreshSeconds = 21600     # re-read the sources and re-sync every 6h
        concurrency = 8            # relays synced at the same time
        exclude = []               # regexes for relays to skip however many sources name them
        relaySource = [
            {
                select = [
                    { tag = "30382:rank",      relay = 2, authors = 1 }
                    { tag = "30382:followers", relay = 2, authors = 1 }
                ]
                filter = { "kinds": [10040] }
            }
        ]
        authorsPerLeg = 1
    }

    contentViaOutbox {
        dir = "down"
        sync = "fetch"
        # 5 (NIP-09 deletion request) and 62 (NIP-62 request to vanish) travel
        # with the content they retract. The store enforces both AT INSERT: a
        # mirrored kind 5 erases the targets it names, a kind 62 sweeps that
        # author's history off this relay — so an author who deleted a note on
        # their own write relay does not keep a copy here.
        #
        # Storing the request is the other half of it, and the half that lasts:
        # the tombstone is what the NEXT cycle's inserts are checked against, so
        # the note stays gone instead of coming back on the following walk. That
        # is what a `deleteMissing` drop cannot do — absence leaves nothing
        # behind to check the re-download against.
        #
        # Adding kinds re-keys the stream's sync bands (they are keyed by the
        # whole filter), so the first cycle after this edit re-walks every
        # discovered relay rather than resuming.
        filter = { "kinds": [
            0, 1, 5, 9, 11, 14, 20, 21, 22, 24, 40, 41, 42, 54, 62, 1010, 1063,
            1065, 1068, 1111, 1163, 1301, 1311, 1312, 1313, 1315, 1337, 1617,
            1618, 1621, 1622, 1630, 1808, 1985, 2003, 2004, 2473, 3302, 5050,
            5100, 5129, 5250, 5302, 5303, 6969, 8333, 9002, 9041, 9321, 9734,
            9735, 9736, 9737, 9802, 10002, 10003, 10040, 10100, 10154, 11871,
            12473, 15128, 15129, 30000, 30001, 30002, 30003, 30004, 30005,
            30006, 30009, 30015, 30017, 30018, 30019, 30020, 30023, 30030,
            30054, 30055, 30063, 30175, 30176, 30177, 30267, 30296, 30297,
            30298, 30311, 30312, 30313, 30315, 30382, 30402, 30617, 30620,
            30817, 30818, 31337, 31871, 31872, 31873, 31890, 31922, 31923,
            31924, 31925, 31990, 32267, 33401, 33863, 34139, 34235, 34236,
            34550, 35128, 35129, 36787, 38000, 38192, 38383, 39000, 39089,
            39092, 39701, 40002, 40100, 45001, 45003, 48106
        ] }
        refreshSeconds = 21600     # re-read the sources and re-sync every 6h
        concurrency = 100          # relays synced at the same time
        exclude = [
            "wss://purplepag.es",
            "wss://profiles.nostr1.com",
            "wss://indexer.coracle.social",
            "wss://user.kindpag.es",
            "wss://directory.yabu.me",
            "wss://filter.nostr.wine/"
        ]
        relaySource = [
            {
                select = [
                   { kind = 10002, tag = "r", marker = "write" }
                ]
                filter = { "kinds": [10002] }
            }
        ]
    }
}

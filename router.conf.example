# Example router config — a strfry-style `streams` mirror.
#
# Copy to router.conf and enable it with:
#   ROUTER_CONFIG_LOCAL=./router.conf \
#   ROUTER_CONFIG_FILE=/etc/vespa-relay/router.conf \
#   ROUTER_BACKFILL_SECONDS=86400 \
#   docker compose up --build
#
# Without Docker, point the relay straight at it:
#   ROUTER_CONFIG_FILE=./router.conf ROUTER_BACKFILL_SECONDS=86400 ./gradlew :relay:run
#
# Each named stream mirrors a NIP-01 `filter` from a set of `urls` in a `dir`
# (down = pull into our store, up = push ours upstream, both). Optional per
# stream: `backfillSeconds` (history window to negentropy-backfill before the
# live tail; overrides ROUTER_BACKFILL_SECONDS) and `trusted` (skip signature
# verification for that upstream — leave off for public relays).
#
# A stream can also drop `urls` entirely and take its relay list from the store,
# with a `relaySource = [ ... ]` list — see the last two streams below.

connectionTimeout = 20

streams {

    # Profile Info + Active services
    popular {
        dir = "down"
        filter = { "kinds": [0, 10002, 10040] }
        urls = [
            "wss://relay.primal.net",
            "wss://relay.damus.io",
            "wss://nos.lol",
            "wss://nostr.mom",
            "wss://nostr-pub.wellorder.net"
            "wss://relay.ditto.pub",
            "wss://wot.grapevine.network"
        ]
    }

    # Indexer Relays
    indexers {
        dir = "down"
        filter = { "kinds": [0, 10002] }
        urls = [
            "wss://purplepag.es",
            "wss://profiles.nostr1.com",
            "wss://indexer.coracle.social",
            "wss://user.kindpag.es",
            "wss://directory.yabu.me"
        ]
    }

    # WoT
    mirrors {
        dir = "down"
        filter = { "kinds": [0, 10002, 30382] }
        urls = [
            "wss://scores.brainstorm.world"
        ]
    }

    # ---- Dynamic relay lists ------------------------------------------------
    #
    # No `urls`: these two take their relays from events the streams above mirror
    # into our store. `relaySource` is a LIST of places to read urls from, all
    # merged into one fan-out. Every `refreshSeconds` the router re-reads them and
    # negentropy-syncs its `filter` against every relay they name — the whole set,
    # however far it has grown — `concurrency` at a time. Relays without NIP-77
    # fall back to a paged REQ fetch automatically, and unreachable ones are
    # tallied and skipped.
    #
    # Each source entry is just where the url sits in a tag, so no kind needs its
    # own code:
    #
    #   kind          the event kind to scan
    #   tag           the tag name to read; omit for ANY tag, which is how you
    #                 take a whole family (NIP-85's <kind>:<type> service tags)
    #                 without naming each one. Omitting it also demands the value
    #                 already start with ws:// or wss://, since with no tag name
    #                 to go on anything in the event could otherwise land here.
    #   urlIndex      which element of the tag holds the url (default 1; use 2 for
    #                 NIP-85 service tags and for e/p/a/q hints, which put an id
    #                 or a pubkey first)
    #   marker        NIP-65 only: keep "write" / "read" / "any", read from the
    #                 slot after the url. Unmarked means both.
    #   sinceSeconds  scan only this far back. Required for regular kinds like 1 —
    #                 scanning one whole would load every note in the store.
    #
    # These need events to fan out over, so keep at least one static `down` stream
    # above: that is what makes the first cycle non-empty.
    #
    # `backfillSeconds` is the history window each cycle reconciles. Keep it
    # comfortably longer than `refreshSeconds` so consecutive cycles overlap
    # instead of leaving a gap between them. Drop it and every cycle reconciles
    # the filter's whole history — fine over negentropy, but a relay without
    # NIP-77 then re-pages its entire history on every single cycle.

    # THE OUTBOX. Every relay anyone publishes to, from every list that names one.
    outbox {
        dir = "down"
        filter = { "kinds": [0, 3, 10002, 10040] }
        backfillSeconds = 172800   # 48h of history per cycle
        refreshSeconds = 21600     # re-read the sources and re-sync every 6h
        concurrency = 8            # relays synced at the same time
        exclude = []               # relays to skip however many sources name them
        relaySource = [
            # NIP-65: write-marked and unmarked relays are where a user publishes.
            { kind = 10002, tag = "r", marker = "write" }
            # NIP-51 relay lists and relay sets — all ["relay", "<url>"].
            { kind = 10012, tag = "relay" }   # feeds
            { kind = 10086, tag = "relay" }   # indexers
            { kind = 10088, tag = "relay" }   # broadcast
            { kind = 30002, tag = "relay" }   # relay sets
            # NIP-17: DM inboxes.
            { kind = 10050, tag = "relay" }
            # NIP-66: a monitor's report describes one relay, named in its `d` tag.
            { kind = 30166, tag = "d" }
            # Relay hints riding on the tags of notes we already mirror. Regular
            # kinds, so they must say how far back to look.
            { kind = 1, tag = "e", urlIndex = 2, sinceSeconds = 86400 }
            { kind = 1, tag = "p", urlIndex = 2, sinceSeconds = 86400 }
            { kind = 1, tag = "q", urlIndex = 2, sinceSeconds = 86400 }
            { kind = 1, tag = "a", urlIndex = 2, sinceSeconds = 86400 }
        ]
    }

    # THE ASSERTION PROVIDERS. Kind 10040 (NIP-85): each service tag —
    # ["30382:rank", "<provider pubkey>", "wss://scores.example"] — names a
    # provider *and* the relay it publishes on, so those relays are the ones
    # worth syncing trust data from. Naming the tag picks one service; drop the
    # `tag` line to take every <kind>:<type> a 10040 carries.
    assertions {
        dir = "down"
        # 30382 users, 30383 events, 30384 addressables, 30385 external ids.
        filter = { "kinds": [30382, 30383, 30384, 30385] }
        backfillSeconds = 172800   # 48h of history per cycle
        refreshSeconds = 21600     # re-read the sources and re-sync every 6h
        concurrency = 8            # relays synced at the same time
        exclude = []               # relays to skip however many sources name them
        relaySource = [
            { kind = 10040, tag = "30382:rank", urlIndex = 2 }
            { kind = 10040, tag = "30382:followers", urlIndex = 2 }
            { kind = 10040, tag = "30383:rank", urlIndex = 2 }
        ]
    }
}

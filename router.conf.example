# Example router config — mirror events from other relays into this one.
#
# The router runs as its own process (the compose `sync` service; the profile
# is the on-switch). Copy this file and start it:
#   cp router.conf.example router.conf
#   SYNC_CONFIG_LOCAL=./router.conf docker compose --profile sync up -d --build
#
# Edited it? Restart only the mirror — the relay keeps serving:
#   docker compose --profile sync restart sync
#
# Running without Docker, set SYNC_CONFIG_FILE to the path of your copy on the
# SYNC process (`./gradlew :sync:run` / the vespa-sync binary) — the relay
# refuses to boot with it set, because it no longer runs the mirror.
#
# This file as it stands is what we run. You can use it unchanged.
#
#
# HOW A STREAM WORKS
#
# Each entry under `streams` mirrors one NIP-01 `filter` from a set of relays:
#
#   dir      "down" pulls into this relay, "up" pushes ours out, "both" does each
#   filter   the NIP-01 filter to mirror — kinds, authors, tags, since/until
#   urls     the relays to talk to
#   sync     how to ask for what we are missing (see below)
#
# Instead of a fixed `urls` list, a stream can find its relays in the events this
# relay already holds — a `relaySource`. That is how the last two streams reach
# tens of thousands of relays without naming any of them.
#
# A third way is `presence`, which does not replace `relaySource` — it SCOPES
# it. The same selects, narrowed to whoever is SIGNED IN right now, one reader at
# a time. See the two `authed*` streams at the bottom; they need two settings on
# each service and are off unless you set them.
#
#
# CHOOSING `sync`
#
#   negentropy  the relays hold much the same events we do. Compares the two sets
#               and transfers only the difference. Right for common kinds.
#   fetch       the relays hold events nobody else has. Comparing two sets that
#               barely overlap costs more than just downloading. Right for a
#               first fill, and for per-publisher data like NIP-85 scores.
#   auto        reconcile once we already hold a lot of the filter, else fetch
#               (the default). Prefer saying which you mean.
#   live        do not ask for history at all — hold the subscription open and
#               take what arrives. No paged walk, no reconcile, and no cursor
#               band, because a tail proves nothing about the span it happened
#               to be open for.

connectionTimeout = 20

streams {

    # Loads a seed of users from popular relays
    indexers {
        dir = "down"
        # Bootstrap. On an empty store there is nothing to reconcile against, and
        # these are what create the overlap every later stream depends on.
        sync = "fetch"
        filter = { "kinds": [0, 10002] }
        urls = [
            "wss://purplepag.es",
            "wss://profiles.nostr1.com",
            "wss://indexer.coracle.social",
            "wss://user.kindpag.es",
            "wss://directory.yabu.me"
        ]
    }

    profileViaOutbox {
        dir = "down"
        sync = "fetch"
        filter = { "kinds": [0, 10002, 10040] }
        refreshSeconds = 21600     # re-read the relay list out of the store every 6h
        # recycleSeconds = 30      # …and start the next pass 30s after this one
        #                          # finishes HANDING OUT its list — not after the
        #                          # relays finish, which is the whole point: the
        #                          # slow ones keep their slots and run on into the
        #                          # next pass. So this is a floor on the gap
        #                          # between laps, NOT a cycle period: the period
        #                          # is the walk plus this, and the walk is paced by
        #                          # the worker pool (18,687 urls took 26:29 to hand
        #                          # out, against which 30s is a tail). Reusing the
        #                          # list is what it buys — deriving one is a store
        #                          # walk, a normalisation pass and one #d query per
        #                          # 500 urls, while the download is the part worth
        #                          # repeating. Unset = one pass per refresh.
        concurrency = 100          # worker pool: relays synced at the same time.
                                   # A pass ends when the last url is handed out,
                                   # not when the last relay finishes, so one slow
                                   # relay costs one slot and not the mirror
        # Ignore any single event naming more relays than this — a real outbox
        # list is single digits, and the ones this exists for run to five
        # (measured: 148 pubkeys publishing kind 10002s of 100-10,591 entries,
        # every entry a dial). The event is dropped WHOLE, never truncated, so
        # its author cannot choose what we see by ordering it.
        #
        # SETTING THIS GIVES UP THE TAG PROJECTION for this source: a per-event
        # limit needs the event, and the projection returns values already
        # flattened across every event it matched. Unset, discovery keeps the
        # projection (a 2.6M-event scan became its walk). Duplicate urls are
        # folded either way — see AGENTS.md, "One relay behind many urls".
        maxRelaysPerList = 50
        # A plain url excludes exactly that relay, matched by its normalized
        # form — host case, a redundant :443, or a missing trailing slash
        # don't matter. An entry with a regex metacharacter (* + ? [ ] etc; a dot
        # doesn't count) is instead a regex that must match a discovered url
        # in full, ignoring case: "wss://filter.nostr.wine/npub.*" drops the
        # per-user urls that host mints (wss://filter.nostr.wine/npub1...)
        # while leaving the relay itself in — a shape no literal list could
        # keep up with.
        exclude = [
            "wss://purplepag.es/",
            "wss://profiles.nostr1.com/",
            "wss://indexer.coracle.social/",
            "wss://user.kindpag.es/",
            "wss://directory.yabu.me/",
            "wss://filter.nostr.wine/npub.*"
        ]
        relaySource = [
            {
                select = [
                   { kind = 10002, tag = "r", marker = "write" }
                ]
                filter = { "kinds": [10002] }
            },
            # NIP-29 group hosts, named by the kind 10009 group lists we hold.
            # A `group` tag is ["group", <id>, <relay url>, <name?>], so the url
            # is element 2 — the one relay list in the protocol that does not
            # put it at 1, which is what `relay = 2` says.
            #
            # On this stream as well as on contentViaOutbox, and for a different
            # reason: a group relay carries its members' kind 0s, and those are
            # the faces and names on every group post the content stream
            # mirrors. Without it a group's posts arrive from a relay nobody
            # else indexes and their authors draw as short npubs.
            {
                select = [
                   { kind = 10009, tag = "group", relay = 2 }
                ]
                filter = { "kinds": [10009] }
            }
        ]
    }

    assertions {
        dir = "down"
        sync   = "negentropy"
        deleteMissing = "dryRun"
        # The provider's relay is the source of truth for its OWN scores, and
        # for nothing else here. Kind 0/10002 ride along so we pick them up if
        # it serves them (NIP-85 says it should; measured, none do) — they are
        # deleted only when a service's whole score set is retracted, never for
        # being absent from a relay that was never going to have them.
        ownedKinds = [30382]
        filter = { "kinds": [0, 10002, 30382] }
        refreshSeconds = 21600     # re-read the relay list out of the store every 6h
        # recycleSeconds = 30      # …and start the next pass 30s after this one
        #                          # finishes HANDING OUT its list — not after the
        #                          # relays finish, which is the whole point: the
        #                          # slow ones keep their slots and run on into the
        #                          # next pass. So this is a floor on the gap
        #                          # between laps, NOT a cycle period: the period
        #                          # is the walk plus this, and the walk is paced by
        #                          # the worker pool (18,687 urls took 26:29 to hand
        #                          # out, against which 30s is a tail). Reusing the
        #                          # list is what it buys — deriving one is a store
        #                          # walk, a normalisation pass and one #d query per
        #                          # 500 urls, while the download is the part worth
        #                          # repeating. Unset = one pass per refresh.
        concurrency = 8            # worker pool: relays synced at the same time
        exclude = []               # urls or regexes for relays to skip however many sources name them
        relaySource = [
            {
                select = [
                    { tag = "30382:rank",      relay = 2, authors = 1 }
                    { tag = "30382:followers", relay = 2, authors = 1 }
                ]
                filter = { "kinds": [10040] }
            }
        ]
        authorsPerLeg = 1
    }

    contentViaOutbox {
        dir = "down"
        sync = "fetch"
        # 5 (NIP-09 deletion request) and 62 (NIP-62 request to vanish) travel
        # with the content they retract. The store enforces both AT INSERT: a
        # mirrored kind 5 erases the targets it names, a kind 62 sweeps that
        # author's history off this relay — so an author who deleted a note on
        # their own write relay does not keep a copy here.
        #
        # Storing the request is the other half of it, and the half that lasts:
        # the tombstone is what the NEXT cycle's inserts are checked against, so
        # the note stays gone instead of coming back on the following walk. That
        # is what a `deleteMissing` drop cannot do — absence leaves nothing
        # behind to check the re-download against.
        #
        # Adding kinds re-keys the stream's sync bands (they are keyed by the
        # whole filter), so the first cycle after this edit re-walks every
        # discovered relay rather than resuming.
        #
        # 10009 (NIP-51 simple group list) is here for two jobs at once: it is
        # what the `group:` search picker reads to offer a reader their OWN
        # groups, and it is the input to the group-relay `relaySource` below —
        # so without it that select scans an empty set and no group host is
        # ever discovered. It rides with 10003 because it is a user's list like
        # any other; the group CONTENT it leads to is kinds 9/11/1111, already
        # here, and the group's own record is 39000, likewise.
        filter = { "kinds": [
            0, 1, 5, 9, 11, 14, 20, 21, 22, 24, 40, 41, 42, 54, 62, 1010, 1063,
            1065, 1068, 1111, 1163, 1301, 1311, 1312, 1313, 1315, 1337, 1617,
            1618, 1621, 1622, 1630, 1808, 1985, 2003, 2004, 2473, 3302, 5050,
            5100, 5129, 5250, 5302, 5303, 6969, 8333, 9002, 9041, 9321, 9734,
            9735, 9736, 9737, 9802, 10002, 10003, 10009, 10040, 10100, 10154,
            11871, 12473, 15128, 15129, 30000, 30001, 30002, 30003, 30004, 30005,
            30006, 30009, 30015, 30017, 30018, 30019, 30020, 30023, 30030,
            30054, 30055, 30063, 30175, 30176, 30177, 30267, 30296, 30297,
            30298, 30311, 30312, 30313, 30315, 30382, 30402, 30617, 30620,
            30817, 30818, 31337, 31871, 31872, 31873, 31890, 31922, 31923,
            31924, 31925, 31990, 32267, 33401, 33863, 34139, 34235, 34236,
            34550, 35128, 35129, 36787, 38000, 38192, 38383, 39000, 39089,
            39092, 39701, 40002, 40100, 45001, 45003, 48106
        ] }
        refreshSeconds = 21600     # re-read the relay list out of the store every 6h
        # recycleSeconds = 30      # …and start the next pass 30s after this one
        #                          # finishes HANDING OUT its list — not after the
        #                          # relays finish, which is the whole point: the
        #                          # slow ones keep their slots and run on into the
        #                          # next pass. So this is a floor on the gap
        #                          # between laps, NOT a cycle period: the period
        #                          # is the walk plus this, and the walk is paced by
        #                          # the worker pool (18,687 urls took 26:29 to hand
        #                          # out, against which 30s is a tail). Reusing the
        #                          # list is what it buys — deriving one is a store
        #                          # walk, a normalisation pass and one #d query per
        #                          # 500 urls, while the download is the part worth
        #                          # repeating. Unset = one pass per refresh.
        concurrency = 100          # worker pool: relays synced at the same time.
                                   # A pass ends when the last url is handed out,
                                   # not when the last relay finishes, so one slow
                                   # relay costs one slot and not the mirror
        exclude = [
            "wss://purplepag.es/",
            "wss://profiles.nostr1.com/",
            "wss://indexer.coracle.social/",
            "wss://user.kindpag.es/",
            "wss://directory.yabu.me/",
            "wss://filter.nostr.wine/npub.*"
        ]
        relaySource = [
            {
                select = [
                   { kind = 10002, tag = "r", marker = "write" }
                ]
                filter = { "kinds": [10002] }
            },
            # The NIP-29 group hosts, so what was posted IN a group is mirrored
            # here and `group:<id>` in the search box has something to find. See
            # profileViaOutbox for the tag's shape; this is the same select.
            #
            # DELIBERATELY UNBOUND. The select could also bind the group id —
            # `{ kind = 10009, tag = "group", relay = 2, "#h" = 1 }` — which
            # would ask each host only for the groups somebody listed, one leg
            # per (relay, group). Two reasons it does not: a search relay wants
            # every public group a host serves and not only the listed ones,
            # and a bound select gives up the tag projection for a paging scan
            # over whole events (see RelayDiscovery.discover). Bind it if this
            # mirror is ever pointed at a host too large to take whole.
            #
            # What no config can do: NIP-29 gates a private group's reads behind
            # NIP-42, and the identity this router signs with is not a member of
            # anybody's group. Private groups are not mirrored, and the reason
            # is membership rather than reachability.
            {
                select = [
                   { kind = 10009, tag = "group", relay = 2 }
                ]
                filter = { "kinds": [10009] }
            }
        ]
    }

    # ------------------------------------------------------------------------
    # THE PEOPLE WHO ARE ACTUALLY HERE
    #
    # `presence { }` does not replace `relaySource` — it SCOPES it. The selects
    # below are the same grammar contentViaOutbox uses, read by the same code;
    # the one thing presence changes is that each scan is narrowed to ONE
    # signed-in reader and re-run every `pollSeconds` instead of walking the
    # whole corpus every six hours.
    #
    # That is what the streams above cannot do at any setting. A reader who
    # signs in is one author among millions and their band is one of thousands;
    # nothing in a six-hour rotation knows they are waiting.
    #
    # `authors = "pubkey"` and `"#p" = "pubkey"` both mean "the scanned event's
    # own author", which under presence is always the reader — so the first
    # source is their OUTBOX asking for their own posts, and the second is their
    # INBOX asking for what mentions them. Same relay list, two markers, two
    # questions.
    #
    # COMMENTED OUT because they need two settings that have no defaults, one on
    # each service, and the sync process refuses to boot with a presence stream
    # and no feed rather than mirroring nothing quietly:
    #
    #   relay:  RELAY_AUTHED_TOKEN=<a shared secret>
    #   sync:   SYNC_AUTHED_URL=http://relay:7777/authed
    #           SYNC_AUTHED_TOKEN=<the same secret>
    #
    # The token is not optional. /authed is the one document this relay serves
    # that names its clients, so with no token the route does not exist at all.
    #
    # authedContentViaOutbox {
    #     dir = "down"
    #     # Tail plus a one-off paged catch-up per (relay, question), so somebody
    #     # signing in gets their backlog and not only their next post. Bands
    #     # make the second visit cost an empty page. Use "live" for the tail
    #     # alone; "negentropy" is refused, because our side of a per-reader
    #     # filter is a full store walk per person per poll.
    #     sync = "fetch"
    #     # contentViaOutbox's own kinds. The point of repeating them rather than
    #     # narrowing is that this stream is not a different corpus, it is the
    #     # same corpus reached from the other end: what the wide fan-out gets to
    #     # in six hours, this gets to in thirty seconds for the person waiting.
    #     filter = { "kinds": [
    #         0, 1, 5, 9, 11, 14, 20, 21, 22, 24, 40, 41, 42, 54, 62, 1010, 1063,
    #         1065, 1068, 1111, 1163, 1301, 1311, 1312, 1313, 1315, 1337, 1617,
    #         1618, 1621, 1622, 1630, 1808, 1985, 2003, 2004, 2473, 3302, 5050,
    #         5100, 5129, 5250, 5302, 5303, 6969, 8333, 9002, 9041, 9321, 9734,
    #         9735, 9736, 9737, 9802, 10002, 10003, 10009, 10040, 10100, 10154,
    #         11871, 12473, 15128, 15129, 30000, 30001, 30002, 30003, 30004, 30005,
    #         30006, 30009, 30015, 30017, 30018, 30019, 30020, 30023, 30030,
    #         30054, 30055, 30063, 30175, 30176, 30177, 30267, 30296, 30297,
    #         30298, 30311, 30312, 30313, 30315, 30382, 30402, 30617, 30620,
    #         30817, 30818, 31337, 31871, 31872, 31873, 31890, 31922, 31923,
    #         31924, 31925, 31990, 32267, 33401, 33863, 34139, 34235, 34236,
    #         34550, 35128, 35129, 36787, 38000, 38192, 38383, 39000, 39089,
    #         39092, 39701, 40002, 40100, 45001, 45003, 48106
    #     ] }
    #     presence = {
    #         pollSeconds = 30       # how soon after signing in we dial. This is
    #                                # the whole latency budget of the feature,
    #                                # so it is seconds. It also re-resolves the
    #                                # lists of readers already here — a 10002
    #                                # changes while its author is online.
    #         concurrency = 4        # catch-ups at once. The tails are sockets,
    #                                # not workers, and are not paced by it.
    #         maxRelaysPerReader = 8 # across BOTH sources. A real relay list is
    #                                # single digits; without this, one of the
    #                                # 10,591-entry ones dials ten thousand
    #                                # relays by signing in.
    #     }
    #     # `refreshSeconds` / `recycleSeconds` / `concurrency` / `authorsPerLeg`
    #     # are the rotation's and are REFUSED here — presence is paced by
    #     # pollSeconds and asks each relay for one author.
    #     maxRelaysPerList = 50      # …but this one still applies, per event
    #     exclude = [
    #         "wss://this.relay.example/",          # never mirror ourselves
    #         "wss://filter.nostr.wine/npub.*"
    #     ]
    #     relaySource = [
    #         # WHAT THEY WROTE, from the relays their own 10002 marks `write`.
    #         # `authors = "pubkey"` binds the scanned event's author — which
    #         # under presence is the reader — so each of their write relays is
    #         # asked for their events and nobody else's. Without it this would
    #         # be a REQ for every kind-1 on somebody's personal relay, per
    #         # reader.
    #         {
    #             select = [
    #                { kind = 10002, tag = "r", marker = "write", authors = "pubkey" }
    #             ]
    #             filter = { "kinds": [10002] }
    #         },
    #         # WHAT MENTIONS THEM, from the relays that same 10002 marks `read`.
    #         # NIP-65's inbox side: replies, zaps, reactions and quotes are
    #         # written to it BY OTHER PEOPLE, so the narrowing is `#p` and not
    #         # `authors` — asking for authors=[reader] on an inbox returns
    #         # nothing, which is the mistake this pair exists to make obvious.
    #         # An unmarked `r` tag is read AND write, so a relay that is both
    #         # gets both questions and two subscriptions.
    #         {
    #             select = [
    #                { kind = 10002, tag = "r", marker = "read", "#p" = "pubkey" }
    #             ]
    #             filter = { "kinds": [10002] }
    #         }
    #     ]
    # }
    #
    # # THE ONE THAT CLOSES THE LOOP ON RANKED SEARCH. The store treats a
    # # reader's lens as a FILTER, so a signed-in reader whose provider has
    # # never been mirrored here gets an EMPTY search — which is what
    # # TrustNotice tells them on login and what readiness.js draws. The
    # # assertions stream above finds providers by scanning stored 10040s every
    # # six hours; this finds the provider of the person who is waiting.
    # #
    # # Same select as the assertions stream's, with one difference that is the
    # # whole point: there the scan is every 10040 in the store, here it is the
    # # reader's own. The relay AND the key still both come out of the tag.
    # authedScores {
    #     dir = "down"
    #     sync = "fetch"
    #     filter = { "kinds": [30382] }
    #     presence = {
    #         concurrency = 2        # a provider's whole card set is large
    #     }
    #     relaySource = [
    #         {
    #             select = [
    #                { kind = 10040, tag = "30382:rank", relay = 2, authors = 1 }
    #             ]
    #             filter = { "kinds": [10040] }
    #         }
    #     ]
    # }
}

# Example router config — the OUTBOX router.
#
# The relay list isn't written here. It is read out of the kind-10002 (NIP-65)
# relay lists this relay's own store already holds: every relay a user marks
# `write` — or leaves unmarked, which means read *and* write — is a relay their
# events go to, so it is a relay we pull from. That set is re-read and re-synced
# on a period, so it grows on its own as more 10002s land in the store.
#
# Copy to router.conf and enable it with:
#   ROUTER_CONFIG_LOCAL=./router.conf.outbox.example \
#   ROUTER_CONFIG_FILE=/etc/vespa-relay/router.conf \
#   docker compose up --build
#
# Without Docker:
#   ROUTER_CONFIG_FILE=./router.conf.outbox.example ./gradlew :relay:run

connectionTimeout = 20

streams {

    # SEED. The dynamic stream below can only fan out over relay lists we
    # actually hold, so first mirror 10002s from the indexers that specialize in
    # them. On a cold store this is what makes the first outbox cycle non-empty.
    indexers {
        dir = "down"
        filter = { "kinds": [0, 10002] }
        backfillSeconds = 31536000
        urls = [
            "wss://purplepag.es",
            "wss://profiles.nostr1.com",
            "wss://indexer.coracle.social",
            "wss://user.kindpag.es",
            "wss://directory.yabu.me",
            "wss://relay.primal.net",
            "wss://relay.damus.io",
            "wss://nos.lol"
        ]
    }

    # THE OUTBOX. No `urls`: the relays come from the 10002s above.
    #
    # Every `refreshSeconds` the router re-reads those lists, ranks each relay by
    # how many lists name it, and negentropy-syncs this `filter` against the top
    # `maxRelays` of them, `concurrency` at a time. Relays without NIP-77 fall
    # back to a paged REQ fetch automatically.
    #
    # `backfillSeconds` is the history window each cycle reconciles. Keep it
    # comfortably longer than `refreshSeconds` so consecutive cycles overlap
    # instead of leaving a gap between them. Drop it entirely and every cycle
    # reconciles the filter's whole history — correct, but far more expensive
    # per round once the fan-out is wide.
    outbox {
        dir = "down"
        filter = { "kinds": [0, 3, 10002, 10040] }
        backfillSeconds = 172800   # 48h of history per cycle
        relaySource {
            kind           = 10002   # NIP-65 relay list metadata
            marker         = "write" # write + unmarked; use "read" or "any" to widen
            refreshSeconds = 21600   # re-read the lists and re-sync every 6h
            maxLists       = 50000   # how many 10002s to scan, newest first
            maxRelays      = 500     # sync the 500 best-referenced (0 = all)
            minReferences  = 2       # ignore relays only one list names
            concurrency    = 8       # relays synced at the same time
            exclude        = []      # relays to skip regardless of ranking
        }
    }
}

# Copy to .env (gitignored) and edit. Docker Compose loads it automatically, so
# `docker compose up --build` picks these up with no env vars on the command line.
#
#   cp .env.example .env
#
# A number outside its range, or a switch that is not true/false, stops the
# boot and names the variable; every example below is in range. The ranges are
# in docs/configuration.md#ranges-the-boot-enforces.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# This relay's own public ws url. Not cosmetic: it is the NIP-42 auth identity
# and the NIP-62 vanish scope, so in production it must be the real url clients
# connect to.
RELAY_URL=ws://localhost:7777

# The port published on the host (the container always listens on 7777).
RELAY_PORT=7777

# Where the web pages are served from, if that differs from RELAY_URL with the
# scheme swapped — behind a proxy that terminates TLS on another host, say.
# Usually leave it unset.
# RELAY_HTTP_URL=

# ---------------------------------------------------------------------------
# Relay identity (NIP-11) — all optional; blank values are omitted from the doc.
# Check what clients see:  curl -sH 'Accept: application/nostr+json' localhost:7777
# ---------------------------------------------------------------------------

RELAY_NAME=SearchOverTrust Relay
RELAY_DESCRIPTION=A Nostr relay aggregator with full-text NIP-50 search, ranked by the searcher's web of trust.
# Also the browser favicon: set this and it replaces the built-in tab icon on
# every page and /favicon.ico redirects to it. Unset, the relay publishes its
# OWN /favicon.ico as the NIP-11 icon, so both are the bundled mark.
RELAY_ICON=
RELAY_BANNER=

# Write authorization and NIP-86 management, all npub1… (bare hex is refused —
# no checksum), comma/space separated. An entry that cannot be read STOPS the relay rather
# than being dropped: a ban that is not enforced, or an admin who cannot
# administer, is indistinguishable from never having configured one.
#
# ALLOW_PUBKEYS=          # empty = everyone may write
# DENY_PUBKEYS=           # subtracted from the above
# RELAY_ADMIN_PUBKEYS=    # set to enable the NIP-86 management API

# The same, by kind. Comma separated numbers; empty allows every kind.
# ALLOW_KINDS=
# DENY_KINDS=

# A human contact (email / uri), then the human operator's npub. The relay's own
# key is NOT set here — it is derived from RELAY_NSEC.
RELAY_CONTACT=
RELAY_CONTACT_PUBKEY=

RELAY_POSTING_POLICY=
RELAY_PRIVACY_POLICY=
RELAY_TERMS_OF_SERVICE=

# ---------------------------------------------------------------------------
# Serving over Tor — the relay's OWN .onion address, so clients can reach it
# without the clearnet name, a certificate or a public IP. The compose profile
# is the on-switch and needs nothing here:
#
#   docker compose --profile onion up -d
#   docker compose logs tor-onion | grep 'reachable at'
#
# The `tor-onion` container mints the address on first start, keeps its key in
# a volume (so it survives restarts — `down -v` is what changes it), writes the
# hostname to the file below, and forwards it to the relay's port. Clients dial
# ws://<address>.onion: port 80, no TLS, because Tor already encrypts and no CA
# signs a certificate for a .onion name.
#
# This is NOT the same as SYNC_TOR_SOCKS further down: that is the client proxy
# the router dials .onion UPSTREAMS through. One is the front door, the other
# is the way out; either can run without the other.
# ---------------------------------------------------------------------------

# Where the hidden service's container publishes its hostname. The relay reads
# it for NIP-42 only — Tor clients sign the address they dialled, and a relay
# that does not recognise its own .onion rejects every one of those auth events,
# which costs those clients their web-of-trust ranking (reads and publishes keep
# working, which is exactly why it would go unnoticed). Compose sets this; a
# bare deployment leaves it unset unless it runs Tor the same way.
# RELAY_ONION_HOSTNAME_FILE=/var/lib/onion/hostname

# The same address declared by hand, for a hidden service you run yourself
# (outside this compose file, on a Tor already on the box). Malformed values
# stop the boot rather than silently costing Tor clients their ranking.
# RELAY_ONION_URL=ws://youraddress.onion

# The clearnet endpoint names the hidden service in an `Onion-Location` header
# on every response — that is how a Tor-capable client moves itself inside the
# network, and how Tor Browser offers the ".onion available" button. Set false
# for an onion you want unlisted: the relay still authenticates clients that
# dial it, it just stops telling everyone the address. Clients cache what they
# were told for a day, so this is a decision to make before publishing.
# RELAY_ONION_ADVERTISE=true

# Extra torrc lines for the hidden service — latency (single-hop mode), tor's
# proof-of-work defenses against introduction flooding, more introduction
# points. Copy tor/onion.extra.conf.example, uncomment what you want, and point
# this at your copy; the shipped file is all comments and changes nothing.
# ONION_EXTRA_LOCAL=./onion.extra.conf

# ---------------------------------------------------------------------------
# Router (upstream mirror) — its own PROCESS since the module split, behind the
# compose `sync` profile. The profile is the on-switch:
#
#   docker compose --profile sync up -d --build
#
# Restarting it (after a sync.conf edit, say) never touches the relay:
#
#   docker compose --profile sync restart sync
#
# TWO FILES. sync.conf says what this relay MIRRORS; monitor.conf says what it
# MEASURES — the relay lists the monitor scans and the clocks its passes run on.
# They are apart because every url the monitor derives becomes a signed, public
# kind-30166 claim about somebody else's relay, so editing the streams must
# never change what this deployment says about anyone. Neither file names
# anything in the other; the mirror's `unwatched` count on /stats.json is what
# says they have drifted apart.
#
# SYNC_CONFIG_LOCAL and MONITOR_CONFIG_LOCAL are the host paths that get
# mounted; start from sync.conf.example and monitor.conf.example. Compose reads
# them here and never passes them to a container. What the RELAY refuses at boot
# is SYNC_CONFIG / SYNC_CONFIG_FILE / MONITOR_CONFIG / MONITOR_CONFIG_FILE: the
# settings below belong to the sync service, which runs both planes.
#
# MONITOR_CONFIG_LOCAL unset means the monitor reads NOTHING — the example is
# mounted but not pointed at, so no deployment starts signing public claims
# about strangers' relays without asking. A sync.conf whose streams discover
# their relays then refuses to boot until you opt in.
# ---------------------------------------------------------------------------

# SYNC_CONFIG_LOCAL=./sync.conf
# MONITOR_CONFIG_LOCAL=./monitor.conf

# Where the sync process reads the relay's mean client-read latency, so its
# repairs yield when searches slow down (ingest needs no yield of its own: the
# relay's mirror lane already does). Compose defaults it to the relay container's
# /pressure endpoint; set it empty to repair at full speed regardless.
# SYNC_PRESSURE_URL=http://relay:7777/pressure

# Where the sync process's writes go: every one of them to the relay, over one
# socket signed in with RELAY_NSEC (both processes need the same key, and the
# sync refuses to boot without it), so the relay is the index's only writer: the
# same policies, the same signature check, and live subscribers see backfilled
# history. The sync opens the store read-only. Compose dials the relay container,
# a bare install RELAY_URL. SYNC_INGEST, which could also write the store from the
# sync process, is gone; `local` stops the boot. See docs/configuration.md.
# SYNC_INGEST_URL=ws://relay:7777

# What the router prints while it works. Empty logs only what a relay complains
# about — NOTICE, CLOSED, failed sends. "sent" adds every REQ/CLOSE we send;
# "full" adds every message received, which is a line per event. This is the
# first thing to turn on when a stream is not doing what you expect.
# SYNC_WIRE_LOG=sent

# Where .onion upstreams are dialled: a Tor SOCKS5 proxy, host:port. Compose
# defaults it to the bundled `tor` service, which the same --profile sync
# starts; set it EMPTY for a clearnet-only deployment.
#
# It is what makes a hidden service reachable at all. The name is resolved
# inside Tor rather than here, which is both the only way a .onion resolves and
# what keeps the local resolver from learning which ones this relay syncs with.
# Without it, discovery drops every .onion it finds and a .onion typed into a
# stream's `urls` refuses to boot — never a stream that quietly mirrors nothing.
#
# Only hidden services take this route; clearnet relays keep the direct client,
# because a 20,000-relay dynamic cycle over Tor is a fraction of the throughput.
# SYNC_TOR_SOCKS=tor:9050

# Send EVERY upstream through Tor, not only the hidden services — a different
# deployment (no relay learns this box's address), not a stronger default.
# Expect much lower throughput, and some large relays refuse exit traffic.
# SYNC_TOR_ALL=false

# A circuit plus a rendezvous, not a TCP handshake: sync.conf's clearnet
# `connectionTimeout = 20` is far too short to size this one. Tor also gets its
# own socket budget, deliberately separate from the clearnet fan-out's, so a
# handful of slow onion dials cannot draw down its slots.
# SYNC_TOR_CONNECT_TIMEOUT_SECONDS=90
#
# 128, not the default 32: an onion probe is spent waiting on Tor's descriptor
# walk, not on local work. Measured going 32 -> 128 on one deployment: onions in
# flight 32 -> 100, the consistency pass's tail rate 0.25/s -> 0.79/s, the tor
# sidecar 82 -> 88 MiB. The monitor's onion gate is min(this, its
# dialConcurrency), so past 100 raise that too.
SYNC_TOR_MAX_SOCKETS=128

# Default for streams that take their relay list from the store, when the
# stream itself does not say. The per-stream key overrides it.
SYNC_DYNAMIC_REFRESH_SECONDS=21600

# Resume state for relays without NIP-77. A paged fetch has no memory, so
# without this every restart re-downloads the relay's whole corpus; with it the
# router asks only for what falls outside the created_at band it already walked.
# Lives in the mounted volume so it survives the container. Keyed by filter —
# edit a stream's filter and that stream starts over, by design.
SYNC_STATE_FILE=/var/lib/vespa-relay/sync-cursors.json

# What each peer will reconcile in one negentropy window, and how far down the
# timeline the running sweep already got. Distinct from the file above: bands
# are the long-lived record of what a relay has given us, this is working state
# a finished sweep throws away — but it is exactly what a killed sync needs to
# resume where it stopped, so it belongs in the volume too.
SYNC_SWEEP_STATE_FILE=/var/lib/vespa-relay/sync-sweeps.json

# WHAT this router mirrors — its running streams and the kinds they ask for —
# written once at boot and read by the relay, which publishes the union as
# `sync.mirrors.kinds` on /stats.json. The kind list exists in sync.conf and
# nowhere else, so without this a client comparing our event count for an author
# against that author's own relay's total compares a filtered mirror against an
# unfiltered one: measured at 31,118 of 89,485, drawn as "35% mirroring" on a
# mirror that was missing nothing. Both services read this name; compose passes
# it to both, so moving the path moves the reader with the writer.
SYNC_MANIFEST_FILE=/var/lib/vespa-relay/sync-manifest.json

# THE MIRROR'S OWN STATUS PAGE — what each stream is doing, what the background
# passes are measuring, and how far the walk has reached, at
# http://localhost:7778/. Served by the sync process itself, from the one stats
# page every service serves — each panel is guarded on the section its document
# carries, so this port draws the mirror's cards and nothing else.
#
# This replaces SYNC_PROGRESS_FILE, which is now REFUSED at boot rather than
# ignored. That file was written here for the relay to read off the shared
# volume and re-narrate on its /stats.html — an arrangement that could not
# answer "is the mirror running", because a file says nothing about the process
# writing it. Hence the heartbeat it carried, and the staleness the relay
# computed from it. A request answers that for free.
#
# Set the port to 0 to serve no page.
SYNC_STATUS_PORT=7778
# How often the document is rebuilt. It is a fold over maps this process
# already holds — no query, no dial — so this is cheap; 30s by default, matched
# to the mirror's own progress tick.
# SYNC_STATUS_INTERVAL_SECONDS=30
# Persisted so a redeploy does not blank the page for a tick.
SYNC_STATUS_FILE=/var/lib/vespa-relay/sync-status.json

# THE MONITOR'S OWN PORT, one past it, at http://localhost:7779/. The same page
# again, drawing the monitor's cards because that is what its document carries:
# which
# relay urls are one server wearing several addresses, which cannot answer the
# same question twice, which are graded `prime` — and the signed kind-30166
# records themselves, read over the relay's own websocket.
#
# Its own page rather than a panel on the mirror's because it answers a
# different question in a different unit: relay urls, not events. An operator
# arrives with one of the two. It is also what the eventual process split
# needs — when this plane moves into its own container, the port it is read at
# does not change.
#
# Set to 0 to serve no monitor page.
MONITOR_STATUS_PORT=7779
MONITOR_STATUS_FILE=/var/lib/vespa-relay/monitor-status.json

# THE PULSE PAGE — WHERE THE STORE'S RESOURCES GO. Not what this deployment
# holds (that is /stats.html) and not what the mirror is doing (that is the
# port above), but what any of it COSTS: engine time by the activity that spent
# it, port calls per document, what the engine matched against what it served,
# what became of the events offered, and — the part worth the page — which
# holder every lock wait was queued behind. Read live from the store's own
# counters, so it is current as of the request and there is no rollup to go
# stale.
#
# ADMINISTRATORS ONLY. Unlike every other page here this document is NOT
# public: it names the observer lenses and search terms driving the load and,
# with client detail on, quotes the queries people typed. `/pulse.json` is
# served only to a pubkey in RELAY_ADMIN_PUBKEYS below, proven with NIP-98 —
# the same list and the same proof as the NIP-86 admin RPC, so there is one
# place to add or remove an operator. SETTING A PORT WITH NO ADMIN KEYS STOPS
# THE BOOT; an open page is never the right answer to a missing setting.
#
# In a browser: open the port and press sign in — a NIP-07 extension signs
# once, and that becomes a 30-minute HttpOnly session cookie. From a script:
# sign a kind-27235 event over the url and method and send it as
# `Authorization: Nostr <base64>`. The tokens are single-use, so a script that
# polls should open a session rather than sign per request.
#
# ITS OWN PORT AS WELL, not instead. The sign-in is the boundary that matters;
# the port is the one that survives a mistake in it. Compose publishes both of
# these on 127.0.0.1 ONLY — like Vespa's ports and unlike the status pages —
# so reach them over an SSH tunnel. Each process serves its own: the relay's
# page has the reads, the mirror's has the ingest. Unset or 0 serves no page.
# PULSE_PORT=7780
# SYNC_PULSE_PORT=7781

# The origin the NIP-98 tokens are signed against — the `u` tag the relay
# checks, which is what stops a token spent here being spent at another
# service. Deliberately NOT taken from the request's Host header, which the
# caller controls. The default is the loopback address the boot line prints,
# which is right for an SSH tunnel; set it only behind a reverse proxy, to the
# origin the browser actually reaches. A mismatch is not silent: the refusal
# tells the client the exact url to sign, and the page signs that.
# PULSE_PUBLIC_URL=http://localhost:7780
# SYNC_PULSE_PUBLIC_URL=http://localhost:7781

# The two sections that describe the PEOPLE using this relay rather than the
# relay itself: the heaviest observer lenses and search terms driving the load
# (a bounded sketch — heavy hitters kept, the tail forgotten), and a slow-read
# log that QUOTES THE QUERY. Off unless you say so. The sign-in above governs
# who can READ them; this governs whether the store RETAINS them at all, which
# is the stronger guarantee and the reason it stays a separate switch.
# PULSE_CLIENT_DETAIL=false
# SYNC_PULSE_CLIENT_DETAIL=false
# Serve the pulse document to anyone, with no sign-in. Allowed ONLY for the
# operational half: with the client-detail switch above also on, the boot is
# REFUSED rather than quietly publishing what people searched for. "Public" and
# "publishes search terms" must never be one forgotten variable apart, and a
# deployment that set the detail flag months ago would not think to re-read it
# when someone opens the page up.
# PULSE_PUBLIC=false
# SYNC_PULSE_PUBLIC=false
# How slow a read has to be to enter that log, in milliseconds. Honoured only
# where the client sections above are on: keeping a log of what people searched
# for that nobody will read is the worst of both, so the boot says so and keeps
# nothing.
# PULSE_SLOW_READ_MS=1000
# SYNC_PULSE_SLOW_READ_MS=1000

# How many events one negentropy reconcile window aims to hold. Past this many
# LOCAL events on a stream's filter, a backfill sweeps the filter in windows
# instead of asking for all of it at once — which is what keeps our id snapshot
# bounded (14.9M ids for one stream, otherwise) and what makes a sync that dies
# at 80% resume instead of restart. A starting size, not a fixed one: the sweep
# shrinks it when a peer refuses or has to split a window itself, grows it back
# on clean ones, and remembers the result per peer. 0 turns windowing off.
SYNC_NEG_PAGE_TARGET=100000

# How far below `now` a sweep stops. A window has to be immutable to be
# checkpointable, and the top of the range is still receiving events; the live
# subscription covers the head.
SYNC_NEG_PAGE_SLACK_SECONDS=60

# Bans and other relay state that must outlive the container. Like the cursor
# file, this belongs in the mounted volume — on the container filesystem it is
# thrown away on the next rebuild.
RELAY_STATE_FILE=/var/lib/vespa-relay/relay-state.json

# This relay's own keypair — nsec1…, the one setting here that holds a SECRET.
# Used everywhere the relay acts as itself. One key, because all three are the same claim:
#
#   NIP-11 `self`  what the relay advertises as its own pubkey. DERIVED from
#                  this, not declared: a typed-in pubkey is an assertion nobody
#                  can check, a derived one is provable against everything below.
#   NIP-42         answers challenges from relays that serve nothing until the
#                  client proves who it is — paid, allowlisted, and a growing
#                  share of the ones an outbox fan-out discovers. An unanswered
#                  challenge looks exactly like a relay with nothing to say.
#   NIP-66         signs the kind 30166 relay-liveness records this relay
#                  publishes. A monitor is its own pubkey with its own profile,
#                  and for a relay that profile is simply the relay's.
#
# The sync process needs the SAME key, and refuses to boot without it: every
# write it makes goes to the relay signed in as it, and the relay writes a
# socket's events as the mirror's only for its own key.
#
# Unset, the relay acts anonymously: no `self`, no challenges answered, no
# liveness published, and no sync can run against it. Everything else works,
# including READING other monitors' 30166s, which needs no key at all.
#
# This makes the relay's activity attributable — every relay it authenticates to
# learns this pubkey, and the 22242s and 30166s it signs are ordinary events
# others may keep. That is the point, and it is why there is no generated
# fallback: an ephemeral key would be a stranger every restart.
#
# Keep it out of git — this file is an example; the real value belongs in .env.
# RELAY_NSEC=nsec1...

# How old an INTERRUPTED sweep's resume cursor may be and still be resumed from.
# A cursor claims a range was compared against the peer AT A POINT IN TIME; past
# this age the sweep starts over instead. It costs at most one sweep either way,
# which is why it still has a default.
#
# It is NOT how often a relay's whole history is re-read — the two shared this
# env var until they were told apart, and the router refuses the old names
# rather than guessing which was meant. That one is `refetchThePastSeconds`, per
# stream, in sync.conf: a claim about the past does go stale (relays gain old
# events, from a backfill elsewhere or a peer catching up), but re-downloading a
# whole corpus is the most expensive thing here that can run on a clock, so the
# stream that pays for it names the period, and unset it does not run.
SYNC_SWEEP_CURSOR_STALE_AFTER_SECONDS=604800

# How often (seconds) up/both streams re-reconcile to push new local events.
SYNC_UP_INTERVAL_SECONDS=300

# Ingest tuning, and the two move TOGETHER — setting one alone is the trap.
# IngestPipeline derives:
#     capacity  = (batch * 4) clamped to [4096, 16384]
#     effective = min(batch, capacity / workers)
# so 16 workers at batch 1000 gives capacity 4096 and an EFFECTIVE batch of
# 256, and throughput comes from the batch, not the worker count (the store
# serializes writes). The router says so on the ingest line when it happens
# ("SYNC_INGEST_BATCH=... capped to ..."), but only if you read it.
#
# 2/8192 is what this deployment runs: capacity 16384 and a full 8192-event
# effective batch, the ceiling spent on batch width rather than worker count,
# since the store serializes writes. The queue is held in HEAP — 16 workers at
# 4096 is how the router once got OOM-killed at a 12Gi limit — but measured
# sync heap runs 550-1900 MB of 8.6 GB at this shape. The cost: every other
# writer (the monitor's verdict edits, the healer, the sweep) queues on the
# same mutex, so wider batches make ingest faster and that tail longer. If the
# fitness pass reports `wedged` verdict writes, this is the knob.
#
# NOTE the code defaults are workers=2 / batch=1000.
SYNC_INGEST_BATCH=8192


# Run only these streams (comma-separated), so one part of the sync can be tuned
# without the rest competing for the same sockets, heap and ingest queue.
# Empty runs every stream the config defines.
# SYNC_STREAMS=contentViaOutbox
SYNC_INGEST_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Parse audit — collect the events quartz cannot read, to fix them upstream.
# ---------------------------------------------------------------------------

# Quartz's own log floor (DEBUG/INFO/WARN/ERROR). It defaults to DEBUG, which
# prints a line for every unparseable event a backfill meets — thousands of them.
# WARN keeps that quiet; use the audit below to see what was dropped instead.
QUARTZ_LOG_LEVEL=WARN

# Set a path to collect parse failures into a grouped JSON report (with raw
# sample events) instead of logging each one. Costs one extra parse per mirrored
# event, so it is a diagnostic run rather than a permanent setting.
# Under docker compose this needs a mount + a pass-through line — see
# docs/configuration.md.
# PARSE_AUDIT_FILE=/var/lib/vespa-relay/parse-audit.json
# PARSE_AUDIT_SAMPLES=5
# PARSE_AUDIT_INTERVAL_SECONDS=60
#
# Under Compose the report is written inside the container, so set this to a
# host directory to read it — without it the file exists but you cannot get at
# it, which is the whole point of writing one.
# PARSE_AUDIT_LOCAL_DIR=./parse-audit

# ---------------------------------------------------------------------------
# Engine and resources
# ---------------------------------------------------------------------------

# Ports published on the host for the search engine. Change them if 8080 or
# 19071 is already taken; nothing inside the containers moves.
VESPA_PORT=8080
VESPA_CONFIG_PORT=19071

# Where the relay finds the engine. Docker Compose sets these to the container
# names, so leave them alone under Compose. Running the relay outside Docker,
# point them at the two ports above.
# VESPA_URL=http://localhost:8080
# VESPA_CONFIG_URL=http://localhost:19071
#
# A Vespa that runs feed and query containers as separate clusters names each,
# comma-separated, for both processes (and runs its own application package, so
# AUTO_DEPLOY=false). Unset, VESPA_URL serves both roles.
# VESPA_FEED_URLS=http://feed-0:8080,http://feed-1:8080
# VESPA_QUERY_URLS=http://query-0:8080,http://query-1:8080

# Container memory limits. They matter because MaxRAMPercentage reads the
# CGROUP: with no limit a JVM sizes its heap against the whole host, so the
# relay once claimed 45% of 47 GiB while the engine was already using 32 GiB —
# two processes entitled to more memory than the machine has. The engine gets
# the largest share because losing it costs a transaction-log replay, while
# either JVM restarts in seconds. The sync process gets the next largest: the
# negentropy id snapshots it holds while reconciling are the biggest
# allocations anything here makes, which is why that limit moved with it when
# the mirror left the relay's container.
#
# These are limits on the CONTAINERS. Docker itself must be allowed more than
# their sum — with the sync profile on, all three together — or the machine is
# oversubscribed before anything starts.
VESPA_MEM_LIMIT=34g
RELAY_MEM_LIMIT=6g
SYNC_MEM_LIMIT=12g

# The relay container's open-files limit: one per client socket, plus the
# relay's own. It must not exceed what the Docker engine may grant, or the
# container is not created.
RELAY_NOFILE=524288

# The sync container's open-files limit, soft and hard: one per upstream relay
# socket, and the router holds every prime relay live at once (up to 4096).
# The same ceiling applies: no more than the engine may grant.
SYNC_NOFILE=524288

# Each JVM's heap, as a percentage of its container's limit. For the sync
# process this is the setting that decides whether a large reconcile finishes
# or dies with OutOfMemoryError.
#
# The bare name reaches BOTH containers; the prefixed spellings override one
# process. Prefer them for anything absolute — the two JVMs are sized 2x
# apart, and an -Xmx tuned for the sync's reconcile heap kills the relay's
# smaller container.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70
# Compose adds -XX:InitialRAMPercentage=35 to the relay's: left to grow, G1 keeps a
# serving heap near 150 MB and collects several times a second under read load
# (docs/decisions/relay-server.md). RELAY_JAVA_TOOL_OPTIONS replaces the lot.
# RELAY_JAVA_TOOL_OPTIONS=
# SYNC_JAVA_TOOL_OPTIONS=

# The container's HTTP access log — one JSON line per request. Vespa's default
# is on, and on a MIRROR that is mostly this deployment talking to itself: the
# store's write path is read-heavy (dedup existence checks, guard probes,
# supersession searches), so ~94% of the requests logged are our own router's
# dedup traffic. Measured on brainstorm staging: ~500 req/s and ~3.2 GB/hour,
# rotated hourly and compressed but never pruned — enough to fill a volume and
# evict the engine off it.
#
# `disabled` where the HTTP client is your own ingest and the useful record is
# the router's stats plus Vespa's metrics; leave unset when real clients query
# this container and you want per-request forensics.
#
# Read by the process that AUTO_DEPLOYs the application package (the relay;
# the sync never deploys) — NOT by Vespa itself. Setting it on
# the engine looks plausible and does nothing.
VESPA_ACCESS_LOG=disabled

# The relay's writer for published EVENTs (docs/configuration.md): `pipeline`, the
# mirror's IngestPipeline and the default, or `queue`, quartz's IngestQueue. The
# pipeline's shape defaults to 2 workers x 1000-event batches, one batch per
# worker waiting; docs/ingest-benchmark.md measured the alternatives.
# RELAY_INGEST=pipeline
# RELAY_INGEST_CONCURRENCY=2
#
# Published events one store write may take (unset = quartz's 64). At 64, a
# 5.3M-event bulk publish held the write lock 93-98% of each 5-minute window at
# ~200-380 ev/s; 1000 lifts that, and stays below the mirror's batch because a
# wider one holds the lock longer for the relay's other writers.
RELAY_INGEST_BATCH=1000
#
# The mirror lane: every write the sync process makes, written by the relay
# through a pipeline of its own. Needs RELAY_NSEC. See docs/configuration.md.
# RELAY_MIRROR_INGEST_CONCURRENCY=2
# RELAY_MIRROR_INGEST_BATCH=1000
# RELAY_MIRROR_INGEST_QUEUE_MB=512
# The most parsed publishes the pipeline holds, in (estimated, high) MB: past it a
# publish waits, holding its connection back. Bounds the heap when every publish
# is a full frame (docs/configuration.md).
# RELAY_INGEST_QUEUE_MB=512

# How the relay's store sends documents to Vespa (the sync writes none of its own):
# `none`, `gzip`, or `auto` (the feed
# client's own default: gzip every body over 512 bytes). Compose sets `none`, for
# its Vespa on this host: gzip cost ~2 ms per kind 3 on the relay and more on
# Vespa, and `none` published 14% more events per second
# (docs/ingest-benchmark.md). Set `gzip` when VESPA_URL is across a WAN, where
# the bytes are the cost (a tag-heavy event gzips to ~40%).
# VESPA_FEED_COMPRESSION=none

# Documents per request through the batch handler the store ships in its
# application package (deployed at boot). 100 per request took 28-31% off
# Vespa's CPU per event against one per request; the stored documents and every
# search are identical. 0 writes one document per request (docs/configuration.md).
# VESPA_FEED_BATCH=100

# Concurrent queries the store sends the engine per bulk operation. Raise it to
# make ingest faster, lower it if searches slow down while mirroring.
VESPA_QUERY_FANOUT=4

# How slow client reads have to get (mean, ms) before mirroring yields between
# batches, so a big sync cannot starve the people searching. Read by the sync
# process, which polls the relay's measured mean over SYNC_PRESSURE_URL.
SERVING_PRESSURE_THRESHOLD_MS=2000

# ---------------------------------------------------------------------------
# Startup and one-off maintenance
# ---------------------------------------------------------------------------

# The relay deploys the schema this build expects on every boot; the sync never
# deploys, and waits until an application serves. Leave it on for the bundled
# single-node Vespa: when the running schema is older than the code, the engine
# rejects writes — a relay that looks healthy while losing everything it mirrors.
#
# Turn it OFF when you deploy your own application package (several nodes,
# separate feed and query containers): the boot deploy posts the whole bundled
# package, which replaces your services.xml. Every store bump is then yours to
# deploy — see AUTO_DEPLOY in docs/configuration.md.
AUTO_DEPLOY=true

# Rebuild the trust view at startup for anything that drifted. The view is
# maintained by write triggers, and a duplicate write never fires one, so it
# drifts over time. Runs in the background: the relay serves immediately and
# ranked search fills in behind it.
#
# OFF here, as we run it: it is a repair pass, not a monitor, and it runs on
# EVERY boot — measured ~12 s of engine time and ~12M documents matched per
# restart. Turn it on for one boot when the trust page's servicesProjected falls
# below servicesNamed, and back off. On a fresh install, leave it on until the
# first boot has run it.
TRUST_RECONCILE_ON_START=false

# How often each process (relay AND sync) re-reads the stored kind-10040 provider
# lists, in seconds. They are cached, and a process only notices the ones written
# through itself, so this is how a list the sync mirrors in becomes a reader's
# rank lens and Trusted List delegation on the relay. 0 turns it off.
#TRUST_PROVIDER_REFRESH_SECONDS=60

# Re-derive every event's search fields once, in the background. Needed after a
# store upgrade that changes how text is indexed — the engine's own reindex
# cannot do it, only re-writing each event can. Walks the whole corpus, so turn
# it on for the one boot that migrates and off again afterwards. The cursor file
# lets a restart resume instead of starting over.
# REINDEX_FTS_ON_START=true
# Scope that walk to the kinds a store upgrade moved (docs/migrations.md names
# them per entry); the engine selects them server-side, so documents of other kinds
# are never shipped to the relay or re-extracted. A value that is not a list of
# kind numbers (or that names none) stops the boot.
# REINDEX_FTS_KINDS=5,14,38000
FTS_CURSOR_FILE=/var/lib/vespa-relay/fts-cursor.txt

# Corpus statistics: what this relay's store holds, counted with Vespa grouping
# queries, published at GET /stats.json and charted at /stats.html. Public
# and anonymous — the numbers are for the whole store, not for any one reader's
# web of trust. The document is persisted so a restart serves the last one
# instead of a blank page while the next rollup runs.
#
# TWO SCHEDULES, because the queries differ by orders of magnitude in cost.
# The counters are the router's heartbeat, a file read, so they can be a minute
# old instead of fifteen. Everything that asks the engine is a walk, because
# even a bare count() visits every document it matches: the event total and
# newest event, the trust chain (every stored kind-30382 score), the kind
# histogram, the distinct pubkeys, the per-bucket distinct-author series (one
# pubkey set per bucket), the relay distribution, and the zap receipts.
#
# Either can be set to 0 to turn that half off; the walks compete with client
# reads, and turning the charts off on a busy box trades every corpus number on
# the page for that engine time.
# With both off nothing is computed and /stats.json serves the state file.
# Per-query timings ride in the document (`queryMs` on each section), which is
# what to read before moving a number between the two.
#
# What we run on a ~500M-event store: the counters hourly and the charts every
# 6 h. A charts pass at relay boot added ~2.4 GiB anon per content node for
# its duration, which a store near its memory limit cannot spend every 15 min.
STATS_COUNTERS_INTERVAL_SECONDS=3600
STATS_INTERVAL_SECONDS=21600
STATS_FILE=/var/lib/vespa-relay/stats.json

# DELETES DATA. Removes every NIP-85 score signed by a provider that no stored
# kind-10040 names — cards nothing can rank with and nobody reads, which a
# mirror accumulates by the million. Anything other than `true` is a DRY RUN
# that reports what it would remove and removes nothing; run that first.
#
# Pair it with narrowing the sync (see sync.conf.example), or the next pass
# downloads what it just freed.
# SWEEP_ORPHAN_SCORES_ON_START=dryRun

# NIP-FE: one client frame (REQ, COUNT or EVENT) POSTed to the relay's URL,
# answered as the socket's own frames (one per line). On by default; see
# docs/configuration.md#commands-over-http-nip-fe.
# HTTP_RELAY=false
# HTTP_RELAY_TOTAL=64
# HTTP_RELAY_DEADLINE_SECONDS=30

# Write limits, raised from the defaults (2,000 tags, 131,072 content, 262,144
# message). The mirror's events meet these as any publish does, and a refusal
# is final: at the defaults a follow list over 2,000 follows is never stored.
# Counted in UTF-16 chars, not bytes, and they apply to public clients too; the
# websocket frame cap follows as 3 x MAX_MESSAGE_LENGTH.
MAX_EVENT_TAGS=20000
MAX_CONTENT_LENGTH=10485760
MAX_MESSAGE_LENGTH=15728640

# ORE-05 POST /search/pubkeys: the public search backend Brainstorm's server
# proxies its Open Ranking to. Off by default; the proxy names the House
# Observer per request. See docs/configuration.md#search-backend-for-brainstorms-open-ranking.
# ORE_ENABLED=true
# ORE_CONCURRENCY=8

# Print the live websocket connection count on every connect/disconnect.
# Verbose on a busy relay; leave off unless you are watching connections.
# LOG_CONNECTIONS=true

# Serve the websocket on Netty directly instead of through Ktor: lower latency and
# less CPU per frame under many live feeds (docs/live-feeds.md). An experiment.
# NATIVE_WEBSOCKET=true

# Overrides the version NIP-11 reports. Unset, the build's own version is used.
# RELAY_VERSION=dev

# Example sync config — mirror events from other relays into this one.
#
# The mirror runs as its own process (the compose `sync` service; the profile is
# the on-switch). TWO FILES: copy this one AND monitor.conf.example, because the
# streams below discover their relays and a deployment that discovers without
# declaring what it measures is refused at boot.
#   cp sync.conf.example sync.conf
#   cp monitor.conf.example monitor.conf
#   SYNC_CONFIG_LOCAL=./sync.conf MONITOR_CONFIG_LOCAL=./monitor.conf \
#     docker compose --profile sync up -d --build
#
# Edited either? Restart only the mirror — the relay keeps serving:
#   docker compose --profile sync restart sync
#
# Running without Docker, set SYNC_CONFIG_FILE and MONITOR_CONFIG_FILE to your
# copies on the SYNC process (`./gradlew :sync:run` / the vespa-sync binary) —
# the relay refuses to boot with either set, because it runs neither plane.
#
# These two files as they stand are what we run — the values, the kinds and the
# schedules of a live deployment — with one thing taken out: our monitor's
# pubkey in the `authors` bindings (see profileViaOutbox). You can use them
# unchanged.
#
#
# TWO PLANES, TWO FILES
#
# The deployment describes two things that never share a clock, and they are
# configured apart:
#
#   monitor.conf   what this deployment MEASURES — the relay lists it scans, and
#                  the clocks its probe passes run on. Every url it derives
#                  becomes a signed, public kind-30166 claim about somebody
#                  else's relay, so that set is its own declaration and nothing
#                  in THIS file widens it. MONITOR_CONFIG_FILE points at it.
#
#   this file      what this relay MIRRORS. A stream whose relaySource consults
#                  those kind-30166 records builds its relay list from the
#                  verdicts — one indexed query, no relay-list parsing, no
#                  per-worker guards — and rides the rotating pool:
#                  socket-owning workers, catch-up pages, then a LIVE TAIL on
#                  the open socket so new events arrive the moment they exist.
#
# A new url is probed by the monitor's fast lane within minutes
# (monitor.conf's fastLaneSeconds) and joins the fan-out on its first `prime`.
#
# The mirror's /stats.json carries `unwatched`: pairs it syncs that no current
# verdict of ours grades. That is the number that says the two files have
# drifted apart — zero is the healthy reading.
#
#
# HOW A STREAM WORKS
#
# Each entry under `streams` mirrors one NIP-01 `filter`:
#
#   dir             "down" pulls into this relay, "up" pushes ours out
#   filter          the NIP-01 filter to mirror — kinds, since/until
#   urls            relays named here directly (bypass the monitor's verdicts)
#   relaySource     where the relay list comes from: scans of relay-list events
#                   (10002, 10009, ...), or monitor kind-30166 verdicts —
#                   `filter = { "kinds": [30166], "#l": ["prime"] }`
#
# WHERE A RELAY COMES FROM IS THE ONLY DIFFERENCE between the two. Both go into
# one roster and are visited the same way: a live tail, a catch-up that pages
# forward from the band's edge, and the two clocks below. There is no separate
# backfill engine and no `sync` knob any more — that pair walked a `urls` relay
# ONCE per process and then live-tailed, so nothing on such a stream could ever
# re-check its own past.
#
# TWO WAYS BACK INTO THE PAST, and a relay gets whichever one it can answer.
# Both are opt-in: unset means that re-check does not run.
#
#   negentropySyncThePastSeconds
#                   when a relay's last verified full pass is older than this,
#                   its next visit reconciles the covered history over NIP-77
#                   in windows and downloads only the difference. A week keeps
#                   history honest for the cost of a trickle — each relay's
#                   clock is its own, so they stagger themselves at
#                   roster/negentropySyncThePastSeconds per second. Only for
#                   relays the monitor measured as answering a NEG-OPEN; one it
#                   measured as refusing is never asked, since the attempt
#                   cannot succeed and a failed one advances no clock.
#   refetchThePastSeconds
#                   when a relay's band is older than this, the whole filter
#                   goes back on the walk and is PAGED again from the plausible
#                   floor. The coarse twin, and the only re-check a relay
#                   without NIP-77 can get — so a stream whose relays are
#                   mixed wants both, the re-fetch on the longer clock.
#
# EITHER ONE CAN BE BANDED BY AGE, which is usually what a large mirror wants:
# records from the last month still move, records from three years ago do not,
# and re-walking the tail at the cadence the last month needs is where a
# mirror's CPU goes. `negentropy` and `refetch` take the list form of the two
# knobs above:
#
#   negentropy = [
#     { maxAge = 2592000,  every = 604800   }   # 0-30d    reconciled weekly
#     { maxAge = 31536000, every = 2592000  }   # 30d-1y   reconciled monthly
#     { every = 31536000 }                       # 1y+      reconciled yearly
#   ]
#
# The bands tile the past: each `maxAge` is a band's older edge and the one
# before it is its newer edge, so every record is in exactly one band. The last
# entry omits `maxAge` to reach the corpus floor. One band is walked per visit,
# youngest first. A negentropy `every = 0` is always due (floored at 15 minutes) — for a
# stream whose upstream is the source of truth and whose past must be re-read as
# of today rather than taken on trust. A list cannot be set beside its scalar:
# they are the same schedule at different resolutions.
#
# `sync = "negentropy" | "fetch" | "auto"` is REFUSED at parse time, and so is
# SYNC_NEG_MIN_EVENTS: they chose a transport for the engine that is gone. The
# transport is decided per relay now, by what the monitor measured it can do.

connectionTimeout = 20

# THE POOL'S SOCKETS AND CPU ARE BUDGETED PER STREAM — see each stream below.
# Every visit-mode stream shares one queue, one worker set and one socket per
# relay, so what is configured is not a pool of its own but a SHARE of that
# one: how many relays may be visited for this stream at once
# (visitConcurrency), how many live subscriptions it may keep open
# (maxLiveConcurrency), and how many of the pool's visits may be doing each job
# for it (refetchConcurrency, negentropyConcurrency). There is no
# catchUpConcurrency: a catch-up runs inside a visit and its legs run one at a
# time, so `visitConcurrency` already bounds it.
#
# There is no router-wide version of any of them, and the old top-level
# `visitConcurrency` / `tailBudget` are REFUSED at parse time rather than
# ignored. What this process can hold open is bounded by the sums: the summed
# dial widths plus the summed tail budgets, plus monitor.dialConcurrency and
# the static upstreams, must stay under the dispatcher's 1,024. That is an
# UPPER bound — a relay two streams both want is one socket charged to both of
# their live budgets — and the router prints the first two at boot when they
# crowd the ceiling.

streams {

    # Loads a seed of users from popular relays. Static urls bypass the
    # verdicts — a pinned upstream is an operator's decision, and the monitor
    # records it like any other relay without gating it.
    indexers {
        dir = "down"

        # THIS STREAM'S SHARE of the one pool. Small: it walks a handful of
        # pinned relays for a seed, and every socket it holds is one the
        # content streams below cannot.
        visitConcurrency = 8
        maxLiveConcurrency = 8

        # Bootstrap. On an empty store there is nothing to reconcile against,
        # and these are what create the overlap every later stream depends on —
        # including the 10002s the monitor's own sources read.
        filter = { "kinds": [0, 10002] }
        # Declared relays are visited exactly like discovered ones — one queue,
        # one tail each, one policy — so these clocks mean here what they mean
        # everywhere. Neither has a default: an absent schedule never runs.
        #
        # BANDED BY AGE: the last month still moves, the 1y+ tail does not, and
        # re-reconciling the tail weekly is where a large mirror's CPU goes
        # (measured: 202M documents visited in 4.3h, 8 of proton's 12 cores).
        # The bands tile the past, so the tail is walked once a year instead of
        # 52 times. Each re-page band stays above the reconcile's cadence for
        # the same ground: set equal, the two collide, since the catch-up runs
        # BEFORE the audit inside a visit.
        negentropy = [
          { maxAge = 2592000,  every = 604800   }   # 0-30d   reconciled weekly
          { maxAge = 31536000, every = 2592000  }   # 30d-1y  reconciled monthly
          { every = 31536000 }                       # 1y+     reconciled yearly
        ]
        refetch = [
          { maxAge = 2592000,  every = 2592000  }   # 0-30d   re-paged monthly
          { maxAge = 31536000, every = 7776000  }   # 30d-1y  re-paged quarterly
          { every = 31536000 }                       # 1y+     re-paged yearly
        ]
        # Heal the source rather than re-download from it forever: ingest
        # refusing a stale event (REPLACED / DELETED / VANISHED) queues the
        # current version back to the relay that served it. Both switches on
        # here only — five relays with an operator behind them is a bounded
        # blast radius. `dir` governs the reconcile; healing still publishes.
        healContent = true
        healRetractions = true
        urls = [
            "wss://purplepag.es",
            "wss://profiles.nostr1.com",
            "wss://indexer.coracle.social",
            "wss://user.kindpag.es",
            "wss://directory.yabu.me"
        ]
    }

    # Every profile, relay list and provider list, from every relay the monitor
    # certifies. Kinds-only asks — author narrowing is gone: with 32M pubkeys
    # in the store no chunking cadence rotates the key space fast enough for
    # narrowing to mean anything, and a kinds-only filter is a few hundred
    # bytes against every relay's message cap.
    profileViaOutbox {
        dir  = "down"
        filter = { "kinds": [0, 10002, 10040] }
        # The widest roster here — every certified relay — and the smallest
        # events, so it dials broadly and keeps a fraction of the tails. The
        # four budgets on every stream have to sum under the dispatcher's
        # ceiling: see `VisitPool.warnOnSocketBudget`, which says so at boot.
        visitConcurrency = 28
        maxLiveConcurrency = 90
        # A stale version served here still earns a correction: the newer one
        # is published back. Content only — asking the whole certified fan-out
        # to DELETE something is a stronger act, so `healRetractions` stays on
        # the indexers alone.
        healContent = true
        # The monitor's verdicts ARE the relay list: kind-30166 records,
        # admitting every relay whose indexed `l` tag says prime and whose
        # record is newer than maxAgeSeconds. A monitor republishes the record
        # when it re-checks, so the event's own clock dates the check — the
        # reading every other NIP-66 consumer applies.
        #
        # WHOSE verdicts is `authors`, and it means what it means in any other
        # NIP-01 filter: left off, EVERY monitor whose 30166s reached this
        # store. On a stock deployment that is one identity, our own, because
        # nothing here mirrors anyone else's 30166s — but add 30166 to a
        # stream's kinds, or point one at a public monitor, and those verdicts
        # join this roster too.
        #
        # A `filter { }` block IS a NIP-01 filter, so `authors` is 64-char hex,
        # exactly as it goes on the wire — copy one out of a REQ and it works.
        # Bech32 stays in the settings that are ours to define (RELAY_NSEC and
        # the relay's pubkey lists); it does not go inside the protocol's own
        # object, and an npub here is refused rather than quietly decoded.
        relaySource = [
            {
                filter = { "kinds": [30166], "#l": ["prime"] }
                # ...naming the monitors to trust, and nobody else. Our own
                # deployment runs this form with its RELAY_NSEC's hex pubkey —
                # the NIP-11 `self` — on every 30166 source and gate, so a
                # stream that ever mirrors 30166 cannot inherit a stranger's
                # verdicts. Put YOUR relay's hex here, not ours:
                # filter = { "kinds": [30166], "#l": ["prime"], "authors": ["3bf0c63f…"] }
                # How stale a verdict may be and still admit its relay, measured
                # on the record's own clock. There is NO default: nothing in the
                # router knows which filters describe a measurement that goes
                # stale and which describe a list that does not, so an unwritten
                # bound is no bound.
                #
                # 48h, not the two-sweeps-plus-slack (14h) that sweepSeconds
                # promises: measured over the 800 newest verdicts of a ~20k
                # candidate corpus, median age 10.4h and a tail past 31h, since
                # one pass covers a fraction of the candidates. A bound tighter
                # than the real re-grade rate drops healthy relays for being
                # un-regraded; 48h clears the tail and still expires a monitor
                # that has genuinely gone silent.
                maxAgeSeconds = 172800
                # How often to RE-READ this source. One indexed query, so it can
                # run far more often than a relay-list scan — and it has to: this
                # is what bounds a newly-certified relay's wait to join the
                # fan-out. Left off it would inherit the stream's refreshSeconds,
                # six hours by default, against a fast lane that verdicts a new
                # url in two minutes.
                refreshSeconds = 120
            }
        ]
        # ROTATING RELAY_NSEC: name the OLD key's hex here first. The new one starts
        # writing verdicts the moment it boots, but the store's existing ones
        # are the old key's, and a source scoped to the new identity alone
        # selects nothing until a full sweep has run — an empty roster for up
        # to `monitor.sweepSeconds`. Scoped to both, or left unscoped, the
        # roster never dips and the old key comes out once the new one covers
        # the corpus.
        #
        # The five indexers are dialled by `indexers` already; excluding them
        # here keeps one relay from being worked twice.
        exclude = [
            "wss://purplepag.es",
            "wss://profiles.nostr1.com",
            "wss://indexer.coracle.social",
            "wss://user.kindpag.es",
            "wss://directory.yabu.me"
        ]
        # The reconcile runs only against relays the monitor measured as
        # answering a NEG-OPEN; the re-page is the only re-check the others
        # get. Banded as on `indexers`, and for the same reason.
        negentropy = [
          { maxAge = 2592000,  every = 604800   }   # 0-30d   reconciled weekly
          { maxAge = 31536000, every = 2592000  }   # 30d-1y  reconciled monthly
          { every = 31536000 }                       # 1y+     reconciled yearly
        ]
        refetch = [
          { maxAge = 2592000,  every = 2592000  }   # 0-30d   re-paged monthly
          { maxAge = 31536000, every = 7776000  }   # 30d-1y  re-paged quarterly
          { every = 31536000 }                       # 1y+     re-paged yearly
        ]
    }

    assertions {
        dir = "down"
        # Narrow: one provider's own scores, on the relays that serve them. Its
        # daily reconcile is the retraction clock, so it keeps a real share.
        visitConcurrency = 12
        maxLiveConcurrency = 12
        # ENFORCED: the provider's relay is the source of truth, and a score
        # it stopped serving is deleted here after — and only after — a clean
        # full reconcile. Start a new deployment at "dryRun" and read the
        # would-delete lines for a few days before flipping this.
        deleteMissing = true
        # The provider's relay is the source of truth for its OWN scores, and
        # for nothing else here. All eight declaration kinds, not 30382 alone:
        # a service that computes them publishes them side by side, and a
        # kind left out here is one this stream mirrors without ever
        # reconciling — the exact shape `deleteMissing` exists to close.
        # It also WIDENS what a bad reconcile can remove, which is why the
        # dryRun advice above is worth taking on the way in.
        ownedKinds = [
            30382, 30383, 30384, 30385,   # NIP-85 assertions: user, event, address, external id
            30392, 30393, 30394, 30395,   # Tapestry Trusted Lists, same four subjects
        ]
        # Only what this relay actually serves, and nothing else — which here
        # means ownedKinds and the filter say the same thing. NIP-85 says a
        # provider should also serve its service key's kind 0 and 10002;
        # measured on 12 (service, relay) pairs, not one does. Asking anyway
        # cost a full-range paged walk per (relay, provider) on EVERY visit: a
        # kind that returns no event earns no band span, and an empty walk
        # records no band, so its leg never closed. Those records reach the
        # store from the profile streams instead, and belong to them.
        #
        # A band is keyed by the whole filter, so editing this line starts
        # every (relay, provider) walk over once — the intended way to force a
        # re-walk, and one pass. Widening it from 30382 to the eight is exactly
        # that edit: expect one full re-walk per (relay, provider) after the
        # first deploy that carries this.
        filter = { "kinds": [
            30382, 30383, 30384, 30385,
            30392, 30393, 30394, 30395,
        ] }
        # How often the 10040 scan rebuilds this stream's AUTHOR SET. Hourly,
        # not six: the narrowing is by author, so a subject who nominates a
        # provider waits this long before any of its scores are mirrored —
        # measured, a provider holding 149,994 scores was still absent two
        # hours after the 10040 that named it. Cheap to shorten: a band is
        # keyed by the filter, so this clock restarts no walk.
        refreshSeconds = 3600
        exclude = []
        # Still a scanned source, and still author-bound: a provider stream's
        # whole meaning is "THIS service's records from THIS relay", which is
        # the one place narrowing earns its keep. The pool makes one ask per
        # bound author, so each (relay, service) band stays valid forever.
        relaySource = [
            {
                # The same 41 delegation tags the monitor's 10040 source
                # names, and named here for a sharper reason: this select
                # BINDS `authors` off element 1. A tagless version would read
                # an `["e", <id>, <relay>]` relay hint as a delegation and bind
                # an EVENT ID as the author to ask for — a band per bogus
                # (relay, author) pair that can never return an event and never
                # stops being re-walked. The tag name is what says element 1 is
                # a provider.
                select = [
                    # kind 30382
                    { tag = "30382:rank",                 relay = 2, authors = 1 }
                    { tag = "30382:followers",            relay = 2, authors = 1 }
                    { tag = "30382:active_hours_end",     relay = 2, authors = 1 }
                    { tag = "30382:active_hours_start",   relay = 2, authors = 1 }
                    { tag = "30382:first_created_at",     relay = 2, authors = 1 }
                    { tag = "30382:post_cnt",             relay = 2, authors = 1 }
                    { tag = "30382:reactions_cnt",        relay = 2, authors = 1 }
                    { tag = "30382:reply_cnt",            relay = 2, authors = 1 }
                    { tag = "30382:reports_cnt_recd",     relay = 2, authors = 1 }
                    { tag = "30382:reports_cnt_sent",     relay = 2, authors = 1 }
                    { tag = "30382:hops",                 relay = 2, authors = 1 }
                    { tag = "30382:muters",               relay = 2, authors = 1 }
                    { tag = "30382:reporters",            relay = 2, authors = 1 }
                    { tag = "30382:t",                    relay = 2, authors = 1 }
                    { tag = "30382:zap_amt_recd",         relay = 2, authors = 1 }
                    { tag = "30382:zap_amt_sent",         relay = 2, authors = 1 }
                    { tag = "30382:zap_avg_amt_day_recd", relay = 2, authors = 1 }
                    { tag = "30382:zap_avg_amt_day_sent", relay = 2, authors = 1 }
                    { tag = "30382:zap_cnt_recd",         relay = 2, authors = 1 }
                    { tag = "30382:zap_cnt_sent",         relay = 2, authors = 1 }
                    # kind 30383
                    { tag = "30383:rank",                 relay = 2, authors = 1 }
                    { tag = "30383:comment_cnt",          relay = 2, authors = 1 }
                    { tag = "30383:quote_cnt",            relay = 2, authors = 1 }
                    { tag = "30383:reaction_cnt",         relay = 2, authors = 1 }
                    { tag = "30383:repost_cnt",           relay = 2, authors = 1 }
                    { tag = "30383:zap_amount",           relay = 2, authors = 1 }
                    { tag = "30383:zap_cnt",              relay = 2, authors = 1 }
                    # kind 30384
                    { tag = "30384:rank",                 relay = 2, authors = 1 }
                    { tag = "30384:comment_cnt",          relay = 2, authors = 1 }
                    { tag = "30384:quote_cnt",            relay = 2, authors = 1 }
                    { tag = "30384:reaction_cnt",         relay = 2, authors = 1 }
                    { tag = "30384:repost_cnt",           relay = 2, authors = 1 }
                    { tag = "30384:zap_amount",           relay = 2, authors = 1 }
                    { tag = "30384:zap_cnt",              relay = 2, authors = 1 }
                    # kind 30385
                    { tag = "30385:rank",                 relay = 2, authors = 1 }
                    { tag = "30385:comment_cnt",          relay = 2, authors = 1 }
                    { tag = "30385:reaction_cnt",         relay = 2, authors = 1 }
                    # Tapestry Trusted Lists delegate bare: no metric, one entry per kind.
                    { tag = "30392",                      relay = 2, authors = 1 }
                    { tag = "30393",                      relay = 2, authors = 1 }
                    { tag = "30394",                      relay = 2, authors = 1 }
                    { tag = "30395",                      relay = 2, authors = 1 }
                ]
                filter = { "kinds": [10040] }
            }
        ]
        # WHICH URLS THIS STREAM MAY DIAL AT ALL. Beside `exclude` and for the
        # same reason: `exclude` says which urls are forbidden however many
        # sources name them, `gatedBy` says which are permitted however many
        # sources found them. Neither is a property of how a url was found,
        # which is all a relaySource entry describes. Every source's discovery
        # is intersected with the union of these.
        #
        # The scan above supplies the (relay, provider) pairing; this supplies
        # the right to be dialled. 300 users write 10040s today; millions will,
        # with the same spammed dead urls a 10002 carries, and without a gate
        # each of them costs a dial and a timeout per cycle forever. An ungated
        # url waits like any new relay: the fast lane probes it within minutes.
        #
        # Any NIP-01 filter can be the gate. This one is monitor verdicts; add
        # `"authors": ["3bf0c63f…"]` to name whose, or point it at a curated list
        # entirely — with a `select` saying where that list keeps its urls,
        # since only kind 30166 has the position fixed by the protocol (the `d`
        # tag). Nothing in the router knows that `s` is the tag or that
        # `prime` is the value — a monitor spelling its opinion
        # `["status", "live"]` needs no code change here, only this filter
        # written differently. A stream with no `gatedBy` dials whatever its
        # sources name and says so at boot.
        gatedBy = [
            { filter = { "kinds": [30166], "#l": ["prime"] }, maxAgeSeconds = 172800, refreshSeconds = 120 }  # 48h: see profileViaOutbox
        ]
        # The deleteMissing comparison runs as this stream's history audit —
        # daily: each (relay, provider) band ages on its own clock, and a
        # deletion decision deserves the full-history reconcile. This IS the
        # retraction comparison's clock — a provider relay that will not answer
        # a NEG-OPEN can never have its scores retracted here, by design.
        negentropySyncThePastSeconds = 86400
        # …and no `refetchThePastSeconds` on purpose: the reconcile above
        # already compares this ask's whole history every day and downloads only
        # the difference, so re-paging the same ground would buy nothing that
        # the audit does not already prove.
    }

    # The content mirror: every public kind worth searching, from every relay
    # the monitor certifies. 5 (NIP-09 deletion request) and 62 (NIP-62 request
    # to vanish) travel with the content they retract — the store enforces both
    # at insert, and the stored tombstone is what keeps later downloads from
    # resurrecting a deleted note. 10009 rides along both as the group picker's
    # source and as the monitor's group-host source.
    #
    # NIP-34's git statuses travel as a set: 1630 opens, and 1631 (applied),
    # 1632 (closed) and 1633 (draft) are how that state ever changes. Mirroring
    # the open one alone — as this file did — leaves every patch and issue
    # showing open forever, and the store INDEXES all four, so the three that
    # were missing were searchable kinds no stream ever fetched.
    #
    # Eleven kinds joined the store's searchable set with the quartz pin under
    # vespa-eventstore c11472eb18 and had never been fetched by anything: the
    # citation trio (31/32/33), the wiki merge request (818) that proposes a
    # change to a 30818 article, the publication pair (30040 index, 30041
    # section), the library family (30045 bookshelf, 30142 learning resource,
    # 32176 Blossom piece index) and the two ratings kinds (31987 relay review,
    # 34259 entity rating). Same shape as the git statuses above — the store
    # indexes them, so leaving them out is a searchable kind no stream fetches —
    # and the reason to fetch them NOW is that a search only ever reaches what
    # this store holds. Their sibling state kinds are deliberately NOT here:
    # 819 (merge accepted) and 30819 (wiki redirect) are wired in quartz but
    # implement no `SearchableEvent`, so this stream, which mirrors what is
    # worth searching, has nothing to do with them. The ask is 205 kinds wide
    # now; relays that cap kinds per filter refuse the whole REQ rather than
    # trimming it, and `FilterWidths` is what learns each relay's cap from its
    # refusal and re-sends the leg in chunks — so widening this list costs
    # nothing on a relay that answers it and one learned chunking on one that
    # does not.
    #
    # The graph and the reactions to it ride here too: 3 (follow lists), 10000
    # (mute lists) and 1984 (reports) are the web-of-trust inputs a ranking
    # service reads, and 6 / 16 (reposts) and 7 (reactions) are what a note's
    # engagement is counted from. They are also the heaviest growth: one
    # 5-minute sample of a large relay had kind 7 at 95 events against kind 1's
    # 80, and paging the past of kind 6 added ~17M events to our store in a
    # day. Size the store for them, or leave them out.
    #
    # The trusted families (1985, 30382-30385, 30392-30395) are here because a
    # search EXPANDS them: a hit on one is answered with the records it points
    # at, and a pointer resolves against what this store holds. Mirroring the
    # 30382s alone — as this file did before — left the other seven pointing
    # into an empty store, so the whole Trusted List half expanded to nothing
    # and looked to a reader exactly like a relay with no lists on it. The
    # `assertions` stream below is the narrow, reconciled version of the same
    # ask, bound to a provider's own relay; this is the wide one.
    contentViaOutbox {
        # The widest stream here, and the one whose audits cost the most: a
        # negentropy pass over ~200 kinds of covered history builds and
        # compares id sets per window, so it is capped well under its dial
        # width. `deferred` on the status page says when a cap is turning work
        # away rather than merely bounding it.
        visitConcurrency = 80
        maxLiveConcurrency = 90
        refetchConcurrency = 4
        negentropyConcurrency = 4

        dir  = "down"
        # Corrections flow back to whichever relay served a stale version.
        healContent = true
        filter = { "kinds": [
            0, 1, 3, 5, 6, 7, 9, 11, 14, 15, 16, 20, 21, 22, 24, 31, 32, 33, 40,
            41, 42, 43, 44, 54, 62, 64, 818, 1010, 1022, 1063, 1065, 1068, 1111,
            1163, 1301, 1311, 1312, 1313, 1315, 1337, 1617, 1618, 1621, 1622,
            1630, 1631, 1632, 1633, 1808, 1984, 1985, 2003, 2004, 2473, 3302,
            5050, 5100, 5129, 5250, 5302, 5303, 5901, 6969, 7516, 8002, 8003,
            8333, 9002, 9007, 9021, 9022, 9035, 9036, 9041, 9321, 9734, 9735,
            9736, 9737, 9802, 9998, 9999, 10000, 10002, 10003, 10009, 10040,
            10100, 10154, 11316, 11333, 11871, 12473, 15128, 15129, 30000,
            30001, 30002, 30003, 30004, 30005, 30006, 30008, 30009, 30015,
            30017, 30018, 30019, 30020, 30023, 30030, 30040, 30041, 30045,
            30054, 30055, 30063, 30066, 30068, 30142, 30175, 30176, 30177,
            30178, 30267, 30296, 30297, 30298, 30311, 30312, 30313, 30315,
            30382, 30383, 30384, 30385, 30392, 30393, 30394, 30395, 30402,
            30617, 30620, 30621, 30817, 30818, 31337, 31871, 31872, 31873,
            31890, 31922, 31923, 31924, 31925, 31987, 31990, 32176, 32267,
            33331, 33401, 33534, 33863, 34139, 34235, 34236, 34259, 34550,
            35128, 35129, 36787, 37516, 37517, 38000, 38192, 38383, 39000,
            39003, 39089, 39092, 39307, 39701, 39998, 39999, 40002, 40003,
            40006, 40007, 40008, 40099, 40100, 40901, 42000, 43001, 43002,
            43003, 43004, 43005, 43006, 45001, 45003, 45010, 46030, 46031,
            48106
        ] }
        relaySource = [
            {
                filter = { "kinds": [30166], "#l": ["prime"] }
                maxAgeSeconds = 172800  # see profileViaOutbox
                refreshSeconds = 120    # see profileViaOutbox
            }
        ]
        exclude = [
            "wss://purplepag.es",
            "wss://profiles.nostr1.com",
            "wss://indexer.coracle.social",
            "wss://user.kindpag.es",
            "wss://directory.yabu.me"
        ]
        # Banded as on `indexers` — and this is the corpus where re-walking the
        # tail costs most.
        negentropy = [
          { maxAge = 2592000,  every = 604800   }   # 0-30d   reconciled weekly
          { maxAge = 31536000, every = 2592000  }   # 30d-1y  reconciled monthly
          { every = 31536000 }                       # 1y+     reconciled yearly
        ]
        refetch = [
          { maxAge = 2592000,  every = 2592000  }   # 0-30d   re-paged monthly
          { maxAge = 31536000, every = 7776000  }   # 30d-1y  re-paged quarterly
          { every = 31536000 }                       # 1y+     re-paged yearly
        ]
    }
}

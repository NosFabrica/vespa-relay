     private val SINGLE_THREADED_PROFILES = setOf(RANK_UNRANKED, RANK_RECENCY, RANK_RECENCY_GATED)
 
+    /**
+     * THE NEWEST-N CUT A RELEVANCE SEARCH ASKS FOR — Vespa's match phase, sent
+     * as query parameters rather than declared on the profile, so the same
+     * profiles keep serving exact answers wherever the cut does not engage.
+     *
+     * A relevance search is the one shape whose cost nothing about the request
+     * can bound: a common word matches millions of postings and every one is
+     * matched and then scored (benchmark/README.md, "Where a common word's
+     * seconds go" — `bitcoin` 4.9s, `nostr` 19.2s on the production relay, at
+     * ANY limit). Spreading that over the match threads halved it and no more,
+     * because the work is the match set. The match phase is the engine's own
+     * answer to that shape: when a query's ESTIMATED match set exceeds
+     * `maxHits`, matching keeps only the `maxHits` newest candidates — by
+     * `created_at`, the attribute the recency profiles already cut on — and
+     * the rank profile scores those. Under the threshold nothing changes and
+     * the answer is exact; over it the answer is "the best of the newest N",
+     * which for a live social corpus is the page a reader means, and the
+     * profile already carried a freshness multiplier saying so.
+     *
+     * MEASURED against a real slice of the staging corpus, see the README
+     * section beside this one: the cut engages only where it must, the page
+     * is byte-identical everywhere it does not, and where it does the query
+     * costs what N costs rather than what the corpus costs.
+     *
+     * NOT on the keyed lookups (a match set the query named itself has nothing
+     * to cut), not on plain recall or the recency pair (their own cut, with a
+     * per-node depth this client mirrors), and not on a COUNT — a count is
+     * the size of the served set and a capped match phase caps `totalCount`
+     * (the same trap [countProfileOf] documents for the recency profiles), so
+     * [build] takes `boundMatchSet = false` there.
+     *
+     * The client ACCEPTS the match-phase degradation on these profiles
+     * (VespaEventIndex.searchRoot), and only that one; every other
+     * degradation is still refused as the partial answer it is.
+     */
+    const val MATCH_PHASE_ATTRIBUTE = "ranking.matchPhase.attribute"
+    const val MATCH_PHASE_ASCENDING = "ranking.matchPhase.ascending"
+    const val MATCH_PHASE_MAX_HITS_PARAM = "ranking.matchPhase.maxHits"
+
+    /** What the cut keeps, per content node. `VESPA_SEARCH_MATCH_PHASE_MAX_HITS` overrides; 0 turns the cut off. */
+    val SEARCH_MATCH_PHASE_MAX_HITS: Int =
+        System.getenv("VESPA_SEARCH_MATCH_PHASE_MAX_HITS")?.toIntOrNull()?.coerceAtLeast(0) ?: DEFAULT_SEARCH_MATCH_PHASE_MAX_HITS
+
+    /**
+     * 10,000. The work behind the cut is the newest window that holds N
+     * matches — N over the word's selectivity — walked against every matcher
+     * in the word group, so the cost is a straight function of N and of
+     * nothing about the corpus: measured on a 1.3M-event staging slice, 4
+     * match threads, `the` (the widest word tried) cost 36ms at 2,000, 69ms at
+     * 10,000, 165ms at 20,000 and 331ms uncut; `nostr` 88 / 127 / 234 / 186ms.
+     * 10,000 keeps a common word near 100ms of engine time, which with the
+     * relay's own floor (~150-200ms: the expansion's companion reads, the
+     * splice, the wire) is the 200ms page the store was asked for; 20,000 —
+     * the recency profiles' depth — buys twice the window at twice the cost.
+     * At a common word's selectivity on the production corpus (`bitcoin` ~2%
+     * of 149M kind 1, ~8k a day) 10,000 is the newest day or so, scored in
+     * full; a rarer word never reaches it and stays exact.
+     *
+     * WHAT THE CUT CHANGES, measured on the same slice: nothing at all where
+     * it does not engage (byte-identical pages), and where it does, the page
+     * becomes the best-ranked of the newest N rather than of the corpus —
+     * top-10 overlap with the exact page 0-5 of 10 for `the`, `nostr`,
+     * `bitcoin` at cuts that engaged. That is the trade, stated plainly: an
+     * exact top-K over millions of matches cannot be had in under a second
+     * (benchmark/README.md), so a deployment picks the depth it can afford
+     * and a page that is "the best of the newest N". 0 asks for exact answers
+     * and the seconds that come with them.
+     */
+    const val DEFAULT_SEARCH_MATCH_PHASE_MAX_HITS = 10_000
+
+    /**
+     * How much deeper a SHORT cut page reruns before falling to exact. A cut
+     * keeps N raw matches, and the trust gate then deletes the untrusted ones
+     * — under a sparse lens a page can come back shorter than its limit while
+     * the corpus holds plenty more, which a pager would read as the end of the
+     * results. So a short degraded page widens the cut ten-fold once, and
+     * only then runs exact: the widened query is still bounded (measured
+     * ~10x the cost of the first), and the exact one is paid only by a lens
+     * too sparse for a hundred thousand candidates to fill a page.
+     */
+    const val MATCH_PHASE_WIDEN = 10
+
+    /** The profiles that rank text over a match set the caller cannot bound — the ones the cut is for. */
+    private val RELEVANCE_PROFILES = setOf(RANK_SEARCH, RANK_TEXT, RANK_DESC, RANK_ASC, RANK_FOLLOWERS)
+
+    /** Whether [build] sends the newest-N cut with [q] on [ranking]. */
+    fun boundsMatchSet(
+        q: EventQuery,
+        ranking: String,
+    ): Boolean = SEARCH_MATCH_PHASE_MAX_HITS > 0 && ranking in RELEVANCE_PROFILES && !singleMatchThread(q, ranking)
+

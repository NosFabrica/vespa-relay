# Example router config — the TRUSTED ASSERTIONS router.
#
# Same shape as the outbox router, different list. A kind-10040 event (NIP-85)
# names the assertion providers a user trusts and, for each one, the relay that
# provider publishes on:
#
#   ["30382:rank", "<provider pubkey>", "wss://scores.example"]
#
# So the relays worth pulling trust data from are exactly the relays the 10040s
# in our store point at. This config reads them out and syncs the assertion
# kinds against every one of them, on a period.
#
# Copy to router.conf and enable it with:
#   ROUTER_CONFIG_LOCAL=./router.conf.assertions.example \
#   ROUTER_CONFIG_FILE=/etc/vespa-relay/router.conf \
#   docker compose up --build
#
# Without Docker:
#   ROUTER_CONFIG_FILE=./router.conf.assertions.example ./gradlew :relay:run

connectionTimeout = 20

streams {

    # SEED. Mirror the 10040s themselves from relays that carry them, so the
    # dynamic stream below has lists to read on the first cycle.
    indexers {
        dir = "down"
        filter = { "kinds": [0, 10002, 10040] }
        backfillSeconds = 31536000
        urls = [
            "wss://relay.primal.net",
            "wss://relay.damus.io",
            "wss://nos.lol",
            "wss://relay.ditto.pub",
            "wss://wot.grapevine.network",
            "wss://scores.brainstorm.world"
        ]
    }

    # THE ASSERTION PROVIDERS. No `urls`: the relays are the ones named in the
    # 10040s above — every one of them, re-synced each cycle. 10040 has no
    # read/write markers (every relay a service tag points at is a relay we
    # sync), so `marker` doesn't apply here.
    assertions {
        dir = "down"
        # 30382 users, 30383 events, 30384 addressables, 30385 external ids.
        filter = { "kinds": [30382, 30383, 30384, 30385] }
        backfillSeconds = 172800   # 48h of history per cycle
        relaySource {
            kind           = 10040  # NIP-85 trusted assertions
            refreshSeconds = 21600  # re-read the lists and re-sync every 6h
            concurrency    = 8      # relays synced at the same time
            exclude        = []     # relays to skip however many lists name them
        }
    }
}

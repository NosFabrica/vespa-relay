# Copy to .env (gitignored) and edit. Docker Compose loads it automatically, so
# `docker compose up --build` picks these up with no env vars on the command line.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# This relay's own public ws url. Not cosmetic: it is the NIP-42 auth identity
# and the NIP-62 vanish scope, so in production it must be the real url clients
# connect to.
RELAY_URL=ws://localhost:7777

# The port published on the host (the container always listens on 7777).
RELAY_PORT=7777

# This relay's own keypair — nsec1…, the one place a SECRET belongs. NIP-11
# self (derived from it), NIP-42 auth, NIP-66 monitor records.
# Generated for this machine. .env is gitignored — keep it that way.
RELAY_NSEC=nsec18mawelhcf3p0uu85ygh44cdgttkcv8uthnfg2pa2pkwy8mt67rmqh2g7ez

# The npub whose web of trust ranks anonymous searches. Somebody's PUBLIC key,
# usually the NIP-85 provider you trust — not this relay's. Leave empty and every
# result sits below the trust floor, so a full store still looks empty.

# ---------------------------------------------------------------------------
# Relay identity (NIP-11) — all optional; blank values are omitted from the doc.
# Check what clients see:  curl -sH 'Accept: application/nostr+json' localhost:7777
# ---------------------------------------------------------------------------
RELAY_NAME=SearchOverTrust Relay
RELAY_DESCRIPTION=A Nostr relay aggregator with full-text NIP-50 search, ranked by the searcher's web of trust.
RELAY_ICON=
RELAY_BANNER=

# A human contact (email / uri), then the human operator's npub. The relay's own
# key is NOT here — it is derived from RELAY_NSEC above.
RELAY_CONTACT=vitor@vitorpamplona.com
RELAY_CONTACT_PUBKEY=npub1gcxzte5zlkncx26j68ez60fzkvtkm9e0vrwdcvsjakxf9mu9qewqlfnj5z

RELAY_POSTING_POLICY=
RELAY_PRIVACY_POLICY=
RELAY_TERMS_OF_SERVICE=

# ---------------------------------------------------------------------------
# Router (upstream mirror). Off unless ROUTER_CONFIG_FILE is set.
# Uncomment both lines to mirror from the relays in ./router.conf — LOCAL is the
# host path that gets mounted, FILE is where the relay reads it inside the
# container. Start from router.conf.example.
# ---------------------------------------------------------------------------

ROUTER_CONFIG_LOCAL=./router.conf
ROUTER_CONFIG_FILE=/etc/vespa-relay/router.conf

# Resume state for relays without NIP-77. A paged fetch has no memory, so
# without this every restart re-downloads the relay's whole corpus; with it the
# router asks only for what falls outside the created_at band it already walked.
# Lives in the mounted volume so it survives the container. Keyed by filter —
# edit a stream's filter and that stream starts over, by design.
ROUTER_SYNC_STATE_FILE=/var/lib/vespa-relay/sync-cursors.json

# How often (seconds) up/both streams re-reconcile to push new local events.
ROUTER_UP_INTERVAL_SECONDS=300

# Ingest tuning. Throughput comes from the batch size, not the worker count.
ROUTER_INGEST_BATCH=1000
ROUTER_INGEST_CONCURRENCY=16

# How a stream asks for what it is missing is declared per stream in
# router.conf (`sync = "negentropy" / "fetch" / "auto"`). These two only apply
# to streams left on "auto", which decides by size: reconcile a relay only when
# both our store and the relay hold at least this many events matching the
# stream's filter. Below that, negentropy's id exchange buys nothing — there is
# too little overlap for it to save a transfer.
# What goes down the wire to upstream relays. Empty still logs NOTICE, CLOSED
# and failed sends — the relay's own explanation of why it stopped serving us.
# "sent" adds every command sent; "full" adds every message received (a line per
# event — for a specific investigation only).
# ROUTER_WIRE_LOG=sent

ROUTER_NEG_MIN_EVENTS=100000
# How long a relay gets to answer the NIP-45 COUNT behind that decision. COUNT
# is optional and widely unimplemented, so a relay that does not support it and
# one that is merely slow look identical: both time out. A relay that does not
# answer is asked once per run and then reconciled.
ROUTER_COUNT_TIMEOUT_MS=5000

# Run only these streams (comma-separated) to tune one part of the sync without
# the others competing for the same sockets, heap and ingest queue. Empty runs
# every stream. The router prints which streams it is NOT running at startup.
# ROUTER_STREAMS=indexers

# ---------------------------------------------------------------------------
# Parse audit — collect the events quartz cannot read, to fix them upstream.
# ---------------------------------------------------------------------------

# Quartz's own log floor (DEBUG/INFO/WARN/ERROR). It defaults to DEBUG, which is
# why malformed profiles log a line per event. Independent of the audit below.
QUARTZ_LOG_LEVEL=WARN

# Inside the container. The compose volume maps /var/lib/vespa-relay to
# PARSE_AUDIT_LOCAL_DIR on the host (./.audit by default), so the report shows up
# as ./.audit/parse-audit.json. Costs one extra parse per mirrored event — turn it
# off once the gaps are collected.
PARSE_AUDIT_FILE=/var/lib/vespa-relay/parse-audit.json
PARSE_AUDIT_SAMPLES=5
PARSE_AUDIT_INTERVAL_SECONDS=60
